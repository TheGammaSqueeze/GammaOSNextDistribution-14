#11-14 21:15:02.748   477   477 I auditd  : type=1400 audit(0.0:104): avc: denied { search } for comm="BootAnimation" name="dri" dev="tmpfs" ino=1108 scontext=u:r:bootanim:s0 tcontext=u:object_r:gpu_device:s0 tclass=dir permissive=0
#Seen on some MTK devices
allow bootanim gpu_device:dir r_dir_perms;

# GammaOS Nano runs in the bootanim domain. To keep music playing with the screen
# off after USB is unplugged it holds a kernel wakelock (/sys/power/wake_lock),
# which needs the block_suspend capability and write access to the wake_lock /
# wake_unlock sysfs nodes. Without these the write returns EPERM and the SoC
# suspends on unplug, killing the audio. (Works under a permissive bootanim today;
# these rules make it correct on an enforcing build too.)
allow bootanim self:capability2 block_suspend;
allow bootanim sysfs_wake_lock:file rw_file_perms;
