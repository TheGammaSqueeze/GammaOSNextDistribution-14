on early-init
    # Silence the vendor audio + power HAL verbose/debug log spam. The prebuilt
    # audio HAL emits "audio_platform: mode(N),devices(...):platform device:
    # OUT_SPK" (and friends) tens of times per second whenever any audio stream is
    # open, which loads logd and burns CPU on every foreground app -- measured on
    # the TrimUI Brick as ~55 audio_platform lines/sec plus AW_PowerHAL churn,
    # stealing cycles from emulators the same way per-frame ALOGs do. Raising each
    # tag to INFO drops the V/D flood but KEEPS I/W/E so genuine HAL faults still
    # show. Set in early-init so it is in place before audioserver/HAL start.
    setprop log.tag.audio_platform I
    setprop log.tag.audio_hw_primary I
    setprop log.tag.audio_route I
    setprop log.tag.AW_PowerHAL I

# RG DS Plus (RK3568, 1 GB RAM, all partitions on one microSD): for the first minutes after boot the
# platform's default timeouts are too tight. Cold app starts exceed the 10 s process-start limit (the
# MediaProvider process was killed in a loop), and the 60 s watchdog and the 3 s Bluetooth stack
# start are hit too. Scale them 3x. Build.HW_TIMEOUT_MULTIPLIER and the native readers pick the value
# up when zygote and the services start; /vendor/build.prop (ro.gammaos.device) is loaded before
# early-init runs.
on early-init && property:ro.gammaos.device=anbernicrgdsplus
    setprop ro.hw_timeout_multiplier 3

on post-fs
    start gammaos_on_boot
    mount none /system/etc/usb_audio_policy_configuration.xml /vendor/etc/usb_audio_policy_configuration.xml bind
    setprop ro.vndk.version ${persist.sys.vndk}
    setprop sys.gammaos.start_audio 1

service gammaos_on_boot /system/bin/gammaos-on-boot.sh
    oneshot
    disabled

# Portrait-native mode (default OFF): apply the SurfaceFlinger orientation flip
# only when the persisted prop is set. This trigger fires when persistent
# properties are read (post-fs-data), which is after post-fs (where the prop is
# still empty) and before surfaceflinger starts, so exec_start runs the resetprop
# synchronously before SF reads the orientation. Runs in gammaos-on-boot.sh's
# phhsu_daemon domain, which can write the property area. The wildcard matches any
# value (portrait / 0 / 90 / 180 / 270 for per-device tuning); the script itself
# no-ops on an unrecognised value, so `landscape`/`normal`/unset stay default.
service gammaos_orient /system/bin/gammaos-on-boot.sh --orient
    oneshot
    disabled

on property:persist.gammaos.nano.natural_orientation=*
    exec_start gammaos_orient

on property:apexd.status=activated
    start adbd

on property:sys.boot_completed=1
    chown wifi system /data/misc/wifi
    chown system wifi /data/misc/wifi/hostapd.conf

on property:persist.sys.phh.mainkeys=*
    setprop qemu.hw.mainkeys ${persist.sys.phh.mainkeys}

# GammaOS: in desktop mode (persist.bootanim.skip_nano=1) force the minimal SecondaryHome launcher
# as the secondary-display home. This overrides any stale persisted value (older builds set it to
# com.android.launcher3, which is not installed on this build, leaving the second screen without a
# launcher). Desktop-only, so the handheld nano dual-screen path is left untouched.
on property:persist.bootanim.skip_nano=1
    setprop persist.gammaos.secondary_home com.gammaos.secondaryhome/com.gammaos.secondaryhome.SecondaryHomeActivity

on property:vendor.debug.sf.latch_unsignaled=1
    setprop debug.sf.latch_unsignaled 1

on property:ro.hardware=mt6761
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6763
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6765
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6771
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6779
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6785
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt8766
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt8768
    setprop debug.sf.disable_hwc_overlays 1

# Normalize the ultra-low-power (deep sleep) toggle to the 0/1 the vendor
# init.gammaos_power.rc force_sleep trigger matches (exact "=1"). Older settings
# UIs wrote the boolean "true"/"false", which never matched, so deep sleep + the
# charging-LED heartbeat stayed off. This maps any legacy boolean value back to 0/1
# both at boot (when persist props load) and on any runtime write, so a device that
# already has "true" persisted self-heals on update without re-toggling. Not a loop:
# writing 1/0 does not re-match the true/false triggers.
on property:persist.gammaos.ultra_low_power_saving_mode=true
    setprop persist.gammaos.ultra_low_power_saving_mode 1

on property:persist.gammaos.ultra_low_power_saving_mode=false
    setprop persist.gammaos.ultra_low_power_saving_mode 0

# Same self-heal for the gamepad and DC-dimming toggles: older toolbox builds wrote
# "true"/"false", but the gammapad.rc and init.rc triggers only match 1/0. Rewriting
# to 1/0 fires those triggers. Not a loop: 1/0 do not re-match the true/false triggers.
on property:persist.gammaos.gamepad.enable=true
    setprop persist.gammaos.gamepad.enable 1

on property:persist.gammaos.gamepad.enable=false
    setprop persist.gammaos.gamepad.enable 0

on property:persist.gammaos.dcdimmingemulation=true
    setprop persist.gammaos.dcdimmingemulation 1

on property:persist.gammaos.dcdimmingemulation=false
    setprop persist.gammaos.dcdimmingemulation 0

service watchdogd-gsi /system/bin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0

# RG DS Plus: the vendor init pins the Mali power policy to always_on (tearing workaround) and the
# Rockchip kbase platform holds the "gpu" kernel wakeup source while the GPU is powered, so
# /sys/power/wakeup_count never returns and Android autosuspend cannot run. While the screen is off
# let the idle GPU power down (which drops that wakeup source); always_on returns with the screen.
on property:sys.screen.state=off && property:ro.gammaos.device=anbernicrgdsplus
    write /sys/devices/platform/fde60000.gpu/power_policy coarse_demand

on property:sys.screen.state=on && property:ro.gammaos.device=anbernicrgdsplus
    write /sys/devices/platform/fde60000.gpu/power_policy always_on

# The vendor force_sleep -> sleep.sh loop writes 'mem' to /sys/power/state without the wakeup_count
# handshake, so it ignores kernel wakelocks. Do not run it while the nano home keeps music playing
# with the screen off (it publishes sys.gammaos.nano.keep_audio next to its nano_music wakelock),
# and restart it when the music stops while the screen is still off. force_sleep sets the
# battery_charging LED to heartbeat for its 5 s countdown, so clear it again when stopping it early.
on property:init.svc.force_sleep=running && property:sys.gammaos.nano.keep_audio=1
    stop force_sleep
    write /sys/class/leds/battery_charging/trigger none

on property:init.svc.cpu_screen_off=running && property:sys.gammaos.nano.keep_audio=1
    stop cpu_screen_off

on property:sys.gammaos.nano.keep_audio=0 && property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.gammaos.usb.connected=0 && property:sys.boot_completed=1
    start force_sleep

# RG DS Plus: drastic-nano is awake again (lid opened, power pressed) while PowerManager may still be on its
# way back from the sleep drastic asked for. The vendor force_sleep -> sleep.sh loop ignores wakelocks and
# would suspend the device under the running game: stop it, as for keep_audio. drastic publishes awake=0
# before it asks for a sleep, so its own sleeps are not touched.
on property:init.svc.force_sleep=running && property:sys.gammaos.drastic_nano.awake=1 && property:sys.gammaos.drastic_nano.lid_owner=1 && property:ro.gammaos.device=anbernicrgdsplus
    stop force_sleep
    write /sys/class/leds/battery_charging/trigger none

on property:init.svc.cpu_screen_off=running && property:sys.gammaos.drastic_nano.awake=1 && property:sys.gammaos.drastic_nano.lid_owner=1 && property:ro.gammaos.device=anbernicrgdsplus
    stop cpu_screen_off

# RG DS Plus: the vendor 8821cs.ko logs at the Realtek INFO level (H2C dumps, every cfg80211 poll),
# about three lines a second while connected, which rolls the kernel log over within minutes. Keep
# warnings, errors and the suspend/resume prints. Every module load resets the parameter to 4; the
# Wi-Fi HAL sets wlan.driver.status=ok after each load, so it is written again.
on property:wlan.driver.status=ok && property:ro.gammaos.device=anbernicrgdsplus
    write /sys/module/8821cs/parameters/rtw_drv_log_level 3

# RG DS Plus nano: MediaProvider (an APEX priv-app, never preopted) runs from its APK because the ART
# background dexopt job waits for IDLE, which nano never reaches. Its cold start then verifies the
# dex on every boot (Verify dex file 630 ms + 385 VerifyClass 785 ms) on the way to the FUSE mount
# that the first game launch after boot waits for. Verify it once, a minute after storage is up (the
# compile runs at background priority). Without -f an existing result is a no-op, so later boots only
# pay for the cmd call. The result goes to logcat, tag gammaos_mp_verify.
service gammaos_mp_verify /system/bin/sh -c "sleep 60; /system/bin/cmd package compile -m verify com.android.providers.media.module 2>&1 | /system/bin/log -t gammaos_mp_verify"
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

on property:sys.gammaos.nano.ext_storage_ready=1 && property:ro.gammaos.device=anbernicrgdsplus && property:sys.gammaos.minimal_boot=1
    start gammaos_mp_verify

# RG DS Plus: the vendor esde_fix.sh re-checks the ES-DE themes bind mount every 5 s by forking
# cmd package list, head, sed, awk and mountpoint, about 70 ms of CPU a second, also when ES-DE is
# not installed. A watcher publishes whether ES-DE is installed (again after every packages.list
# rewrite) and esde_fix only runs while it is. The watcher starts at boot, which runs in nano and in
# full mode after post-fs-data has switched init to the default mount namespace (so it sees the
# mounts of esde_fix) and before boot_completed (so the vendor start of esde_fix is undone at once).
# Nano never fires zygote-start, so that event cannot be used here.
service gammaos_esde_gate /system/bin/gammaos-on-boot.sh --esde-gate
    disabled

on boot && property:ro.gammaos.device=anbernicrgdsplus
    start gammaos_esde_gate

# RG DS Plus: every device IRQ runs on CPU0, and the vendor init.rk356x.rc pin that should move the
# VOP IRQ to CPU1 names IRQ 38, which is the IEP on kernel 6.1. The script finds the VOP and GPU IRQs
# by name and pins them (VOP to CPU1, GPU to CPU2; CPU3 stays free for the emulator thread). Suspend
# resets the pins (the secondary CPUs go offline), so it runs again at every screen on. The
# persist.gammaos.irq_spread=0 kill switch is read by the script.
service gammaos_irq_spread /system/bin/gammaos-on-boot.sh --irq-spread
    oneshot
    disabled

on boot && property:ro.gammaos.device=anbernicrgdsplus
    start gammaos_irq_spread

on property:sys.screen.state=on && property:ro.gammaos.device=anbernicrgdsplus
    start gammaos_irq_spread

# RG DS Plus: the vendor setclock_max / setclock_stock / setclock_powersave services (init.gammaos_power.rc)
# are separate oneshot scripts that run side by side, and the last one to write a node wins. A powersave
# run that the vendor screen-off trigger or a nano sleep path started before a suspend often ends after
# the wake's setclock_max/stock run, which left the GPU at 400 MHz and the CPU at 1416 MHz until a reboot
# although persist.gammaos.performance_mode was max. While the device is awake (screen on, and no nano
# process putting it to sleep) a foreign setclock run that ends starts the persisted mode's service
# again (R1), and that service runs once more after the run in progress (R2, through the clock_rerun
# marker; `start` on a running oneshot does nothing), so its writes come after everything the foreign
# run wrote. The rerun flag is cleared before the service starts and only R1 sets it, so it cannot loop.
# The nano processes set sys.gammaos.nano.clock_hold=1 before their own pre-sleep powersave run
# (NanoClockProfile.h) so R1 does not undo it; init clears it at every screen on, so a process that dies
# mid-sleep cannot leave it set. There are no rules for the powersave mode.
on property:sys.screen.state=on && property:ro.gammaos.device=anbernicrgdsplus
    setprop sys.gammaos.nano.clock_hold 0

# mode max: R1 on a powersave or stock run ending, R2 on the service itself ending
on property:init.svc.setclock_powersave=stopped && property:persist.gammaos.performance_mode=max && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    start setclock_max
    setprop sys.gammaos.nano.clock_rerun max

on property:init.svc.setclock_stock=stopped && property:persist.gammaos.performance_mode=max && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    start setclock_max
    setprop sys.gammaos.nano.clock_rerun max

on property:init.svc.setclock_max=stopped && property:sys.gammaos.nano.clock_rerun=max && property:persist.gammaos.performance_mode=max && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    setprop sys.gammaos.nano.clock_rerun 0
    start setclock_max

# mode stock: the same with a powersave or max run ending
on property:init.svc.setclock_powersave=stopped && property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    start setclock_stock
    setprop sys.gammaos.nano.clock_rerun stock

on property:init.svc.setclock_max=stopped && property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    start setclock_stock
    setprop sys.gammaos.nano.clock_rerun stock

on property:init.svc.setclock_stock=stopped && property:sys.gammaos.nano.clock_rerun=stock && property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on && property:sys.gammaos.nano.clock_hold=0 && property:ro.gammaos.device=anbernicrgdsplus
    setprop sys.gammaos.nano.clock_rerun 0
    start setclock_stock

on property:init.svc.esde_fix=running && property:sys.gammaos.esde_installed=0 && property:ro.gammaos.device=anbernicrgdsplus
    stop esde_fix

on property:sys.gammaos.esde_installed=1 && property:sys.boot_completed=1 && property:sys.user.0.ce_available=true && property:persist.sys.device_provisioned=1 && property:ro.gammaos.device=anbernicrgdsplus
    start esde_fix
