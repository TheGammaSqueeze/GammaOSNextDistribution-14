on early-init
    # Silence the vendor audio + power HAL verbose/debug log spam. The prebuilt
    # audio HAL emits "audio_platform: mode(N),devices(...):platform device:
    # OUT_SPK" (and friends) tens of times per second whenever any audio stream is
    # open, which loads logd and burns CPU on every foreground app -- measured on
    # the TrimUI Brick as ~55 audio_platform lines/sec plus AW_PowerHAL churn,
    # stealing cycles from emulators the same way per-frame ALOGs do. Raising each
    # tag to INFO drops the V/D flood but KEEPS I/W/E so genuine HAL faults still
    # show. Set in early-init so it is in place before audioserver/HAL start.
    setprop log.tag.audio_platform I
    setprop log.tag.audio_hw_primary I
    setprop log.tag.audio_route I
    setprop log.tag.AW_PowerHAL I

on post-fs
    start gammaos_on_boot
    mount none /system/etc/usb_audio_policy_configuration.xml /vendor/etc/usb_audio_policy_configuration.xml bind
    setprop ro.vndk.version ${persist.sys.vndk}
    setprop sys.gammaos.start_audio 1

service gammaos_on_boot /system/bin/gammaos-on-boot.sh
    oneshot
    disabled

# Portrait-native mode (default OFF): apply the SurfaceFlinger orientation flip
# only when the persisted prop is set. This trigger fires when persistent
# properties are read (post-fs-data), which is after post-fs (where the prop is
# still empty) and before surfaceflinger starts, so exec_start runs the resetprop
# synchronously before SF reads the orientation. Runs in gammaos-on-boot.sh's
# phhsu_daemon domain, which can write the property area. The wildcard matches any
# value (portrait / 0 / 90 / 180 / 270 for per-device tuning); the script itself
# no-ops on an unrecognised value, so `landscape`/`normal`/unset stay default.
service gammaos_orient /system/bin/gammaos-on-boot.sh --orient
    oneshot
    disabled

on property:persist.gammaos.nano.natural_orientation=*
    exec_start gammaos_orient

on property:apexd.status=activated
    start adbd

on property:sys.boot_completed=1
    chown wifi system /data/misc/wifi
    chown system wifi /data/misc/wifi/hostapd.conf

on property:persist.sys.phh.mainkeys=*
    setprop qemu.hw.mainkeys ${persist.sys.phh.mainkeys}

on property:vendor.debug.sf.latch_unsignaled=1
    setprop debug.sf.latch_unsignaled 1

on property:ro.hardware=mt6761
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6763
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6765
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6771
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6779
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt6785
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt8766
    setprop debug.sf.disable_hwc_overlays 1
on property:ro.hardware=mt8768
    setprop debug.sf.disable_hwc_overlays 1

# Normalize the ultra-low-power (deep sleep) toggle to the 0/1 the vendor
# init.gammaos_power.rc force_sleep trigger matches (exact "=1"). Older settings
# UIs wrote the boolean "true"/"false", which never matched, so deep sleep + the
# charging-LED heartbeat stayed off. This maps any legacy boolean value back to 0/1
# both at boot (when persist props load) and on any runtime write, so a device that
# already has "true" persisted self-heals on update without re-toggling. Not a loop:
# writing 1/0 does not re-match the true/false triggers.
on property:persist.gammaos.ultra_low_power_saving_mode=true
    setprop persist.gammaos.ultra_low_power_saving_mode 1

on property:persist.gammaos.ultra_low_power_saving_mode=false
    setprop persist.gammaos.ultra_low_power_saving_mode 0

service watchdogd-gsi /system/bin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0
