# GammaOS: the Syncthing background service.
#
# Control is by properties only, like gammaos-sharefs, so none of the UIs (nano, Settings,
# TV Settings) needs the right to start a service itself:
#   persist.gammaos.syncthing.enabled   1 = run from boot, 0 = stopped (the UI toggle)
#   sys.gammaos.syncthing.restart       set to 1 to bounce the daemon (cleared here)
#
# The home holds the config, keys and database. It is under /data/misc so it inherits the
# device-encrypted policy of that tree and is usable before the user unlocks. The daemon runs as
# system with the media_rw group so it can sync folders under /data/media (internal storage) and
# reads /system/etc/resolv.conf for the public discovery and relay hostnames (see Android.bp).
#
# STMONITORED=1 + --no-restart: Syncthing normally forks a monitor process that re-executes the
# real daemon and restarts it on config changes; the monitor is also what writes a log file.
# Under init that would be two processes (about 20 MB of extra RSS on a 1 GB device). With the
# environment variable the binary runs as the daemon directly, and with the flag it exits when a
# restart is needed and init starts it again. The daemon keeps its recent log in memory
# (/rest/system/log), which is what the nano and Settings screens show.
#
# SSL_CERT_DIR: this is the linux (not android) build of Go, whose certificate loader only looks
# in /etc/ssl and /etc/pki, so it is pointed at Android's CA store explicitly. Without it every
# https connection (relay directory, global discovery) fails with "certificate signed by unknown
# authority". Seen on the RG DS Plus, fixed by this line.

on post-fs-data
    mkdir /data/misc/syncthing 0700 system system

service syncthing /system/bin/syncthing serve --home=/data/misc/syncthing --no-browser --no-upgrade --no-port-probing --no-restart --gui-address=127.0.0.1:8384
    class late_start
    user system
    # media_rw: internal storage under /data/media and the raw card mounts vold makes for it.
    # external_storage: the /mnt/media_rw directory those raw card mounts live in is root:external_storage.
    group system media_rw external_storage inet
    seclabel u:r:syncthing:s0
    setenv HOME /data/misc/syncthing
    setenv STNOUPGRADE 1
    setenv STMONITORED 1
    setenv SSL_CERT_DIR /system/etc/security/cacerts
    setenv GOMAXPROCS 2
    disabled

on property:persist.gammaos.syncthing.enabled=1 && property:sys.boot_completed=1
    start syncthing

on property:persist.gammaos.syncthing.enabled=0
    stop syncthing

on property:sys.gammaos.syncthing.restart=1
    setprop sys.gammaos.syncthing.restart 0
    restart syncthing
