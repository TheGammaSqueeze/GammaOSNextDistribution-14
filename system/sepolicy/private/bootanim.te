typeattribute bootanim coredomain;

permissive bootanim;
init_daemon_domain(bootanim)

# b/68864350
dontaudit bootanim unlabeled:dir search;

# Bootanim should not be reading default vendor-defined properties.
dontaudit bootanim vendor_default_prop:file read;

# Read ro.boot.bootreason b/30654343
get_prop(bootanim, bootloader_boot_reason_prop)

get_prop(bootanim, bootanim_config_prop)

# Allow updating boot animation status.
set_prop(bootanim, bootanim_system_prop)

# Allow accessing /data/misc/bootanim
r_dir_file(bootanim, bootanim_data_file)

# Allow accessing vendor apex for EGL/GLES
allow bootanim vendor_apex_metadata_file:dir r_dir_perms;

# GammaOS Nano: allow brightness control via sysfs backlight
allow bootanim sysfs_leds:dir r_dir_perms;
allow bootanim sysfs_leds:file rw_file_perms;
allow bootanim sysfs_leds:lnk_file read;

# GammaOS Nano: allow exclusive input grab (EVIOCGRAB) for menu navigation
allow bootanim input_device:dir r_dir_perms;
allow bootanim input_device:chr_file { read write open ioctl getattr };

# GammaOS Nano: read persist.gammaos.* properties (skip_nano check)
get_prop(bootanim, persist_gammaos_prop)

# GammaOS Nano: read ro.persistent_properties.ready so NanoMenu can wait
# for /data persist props to be loaded before reading skip_nano. Without
# this rule property_get returns "" in this domain even in permissive
# mode on some kernels, which makes the wait-until-ready loop spin out
# its full timeout and the subsequent skip_nano read also returns "" -
# leading to a misclassification of the boot mode.
get_prop(bootanim, persistent_properties_ready_prop)

# GammaOS Nano: allow handing off to bootanim when nano mode is disabled
set_prop(bootanim, ctl_bootanim_prop)

# GammaOS Nano: set sys.gammaos.nano.launch_* properties for direct game launch
set_prop(bootanim, persist_gammaos_prop)

# GammaOS Nano: read RetroArch playlist from /data/media/0/
# Traverse /data/media/ directory (media_userdir_file)
allow bootanim media_userdir_file:dir { search getattr open read };
# Traverse and read files under /data/media/0/... (media_rw_data_file)
allow bootanim media_rw_data_file:dir { search getattr open read };
allow bootanim media_rw_data_file:file { read getattr open };

# GammaOS Nano GammaShader menu: persist the live shader parameter overrides at
# /data/media/0/GammaShader/.shader_params (media_rw_data_file), creating the
# GammaShader folder on first use. Atomic writes go through a temp file plus rename,
# hence the create/rename/unlink perms. (bootanim is permissive on current devices;
# these keep it correct on an enforcing build too.)
allow bootanim media_rw_data_file:dir { write add_name remove_name create };
allow bootanim media_rw_data_file:file { write create setattr unlink rename };

# GammaOS Nano GammaShader menu: enumerate the RetroArch shader library straight out
# of the app-private install (/data/data/com.retroarch.aarch64/shaders/**) so the user
# can pick a preset. RetroArch's private files carry the generic app_data_file label
# with no MLS category on this build, so the browser needs read + traverse over
# app_data_file. Read only; the menu never writes into app-private storage. (The
# display server loads the chosen preset from the same path itself - see
# surfaceflinger.te.)
allow bootanim app_data_file:dir { search getattr open read };
allow bootanim app_data_file:file { read getattr open };
allow bootanim app_data_file:lnk_file { read getattr };

# GammaOS OTA: allow NanoMenu to trigger OTA mode
set_prop(bootanim, ctl_gammaosota_prop)
set_prop(bootanim, gammaosota_prop)

# GammaOS Nano dynamic game systems: scan user-chosen raw ROM roots. The
# bootanim domain is permissive on current devices, but these explicit allow
# rules keep the raw-path readdir/read correct in enforcing mode too.
# /storage/... mountpoint traversal (primary emulated + removable SD)
#
# Two labels are needed here, and only the second one actually fires on this device. /storage is a
# bind of the /mnt/user/0 tmpfs subtree, and a label follows the inode rather than the path, so
# everything reached through /storage carries the mnt_user_file label that file_contexts gives
# /mnt/user(/.*)? - the /storage(/.*)? entry never gets a chance to apply. The storage_file rules
# are kept for configurations where /storage is a mount in its own right; without the mnt_user_file
# ones, opendir("/storage") is denied and the menu silently finds no removable SD cards and no
# network shares, which is how this was missed for as long as the domain stayed permissive.
allow bootanim storage_file:dir { search getattr open read };
allow bootanim storage_file:lnk_file { read getattr };
allow bootanim mnt_user_file:dir { search getattr open read };
allow bootanim mnt_user_file:lnk_file { read getattr };
# Underlying removable/emulated filesystems (vfat/exfat/fuse/fuseblk/sdcardfs)
allow bootanim sdcard_type:dir { search getattr open read };
allow bootanim sdcard_type:file { read getattr open };
allow bootanim sdcard_type:lnk_file { read getattr };
# Raw vold mounts under /mnt/media_rw/<UUID>
allow bootanim mnt_media_rw_file:dir { search getattr open read };
allow bootanim mnt_media_rw_file:file { read getattr open };
allow bootanim mnt_media_rw_file:lnk_file { read getattr };

# GammaOS Nano dynamic game systems: persist the user systems config + icon
# overrides at /data/system/nano_systems.json + /data/system/nano_user_icons/
# (system_data_file, inherits /data/(.*)?). Atomic write (temp + fsync + rename)
# plus the CHOWN/FOWNER re-own, so the wide create/rename/unlink/setattr perms
# are all exercised.
allow bootanim system_data_file:dir { search getattr open read write add_name remove_name };
allow bootanim system_data_file:file { create open read write getattr setattr unlink rename lock };
