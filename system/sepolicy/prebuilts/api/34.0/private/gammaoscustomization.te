type gammaoscustomization, domain, coredomain;
type gammaoscustomization_exec, exec_type, system_file_type, file_type;

permissive gammaoscustomization;
init_daemon_domain(gammaoscustomization)

# Allow it to set/read GammaOS persist props
set_prop(gammaoscustomization, persist_gammaos_prop)
get_prop(gammaoscustomization, persist_gammaos_prop)

# It uses lots of toolbox/system binaries and /system/bin/sh
allow gammaoscustomization toolbox_exec:file { read open getattr execute execute_no_trans map };
allow gammaoscustomization system_file:file { read open getattr execute execute_no_trans map };
allow gammaoscustomization shell_exec:file { read open getattr map execute execute_no_trans };

# If you keep setenforce inside the script (not recommended)
allow gammaoscustomization selinuxfs:file { open read write getattr };

# Binder usage for talking to system services / package manager
binder_use(gammaoscustomization)
allow gammaoscustomization package_service:service_manager find;
binder_call(gammaoscustomization, system_server)

# Read the APK/tars from /system/etc
allow gammaoscustomization system_file:file r_file_perms;

allow gammaoscustomization shell_exec:file entrypoint;
allow gammaoscustomization sysfs:dir search;
set_prop(gammaoscustomization, ctl_stop_prop)
set_prop(gammaoscustomization, ctl_start_prop)
get_prop(gammaoscustomization, provisioned_prop)
set_prop(gammaoscustomization, provisioned_prop)

# settings put ...
allow gammaoscustomization settings_service:service_manager find;

# cmd bluetooth_manager ...
allow gammaoscustomization bluetooth_manager_service:service_manager find;

# am force-stop / ActivityManager
allow gammaoscustomization activity_service:service_manager find;

allow gammaoscustomization package_service:service_manager find;
allow gammaoscustomization sysfs:dir search;
allow system_server gammaoscustomization:binder call;
allow gammaoscustomization app_data_file:dir { getattr search open read write };
allow gammaoscustomization app_data_file:file { getattr open read write };
set_prop(gammaoscustomization, system_prop)
set_prop(system_app, system_prop)
allow gammaoscustomization shell_exec:file entrypoint;

allow gammaoscustomization system_data_file:dir { getattr search open read write create add_name remove_name mounton };
allow gammaoscustomization system_data_file:file { getattr open read write create mounton };
allow gammaoscustomization app_data_file:dir { getattr search open read mounton };
allow gammaoscustomization app_data_file:file { getattr open read mounton };
allow gammaoscustomization media_rw_data_file:dir { getattr search open read mounton };
allow gammaoscustomization media_rw_data_file:file { getattr open read mounton };
allow gammaoscustomization mnt_user_file:dir { getattr search open read write create add_name mounton };
allow gammaoscustomization mnt_user_file:file { getattr open read write create mounton };
allow gammaoscustomization labeledfs:filesystem { mount unmount };
allow gammaoscustomization tmpfs:filesystem { mount unmount };
