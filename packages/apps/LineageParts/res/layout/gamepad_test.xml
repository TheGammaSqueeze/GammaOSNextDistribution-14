<?xml version="1.0" encoding="utf-8"?>
<!--
     GammaOS Gamepad Test Screen Layout
     SPDX-License-Identifier: Apache-2.0
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="12dp">

    <!-- Analog sticks row — takes proportional space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_test_left_stick"
                android:textSize="13sp" />

            <org.lineageos.lineageparts.input.AnalogStickView
                android:id="@+id/left_stick_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/left_stick_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X: 0.00  Y: 0.00"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_test_right_stick"
                android:textSize="13sp" />

            <org.lineageos.lineageparts.input.AnalogStickView
                android:id="@+id/right_stick_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/right_stick_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X: 0.00  Y: 0.00"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Triggers row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_test_left_trigger"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:paddingEnd="4dp" />

            <org.lineageos.lineageparts.input.TriggerBarView
                android:id="@+id/left_trigger_view"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_test_right_trigger"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:paddingEnd="4dp" />

            <org.lineageos.lineageparts.input.TriggerBarView
                android:id="@+id/right_trigger_view"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Button grid: 3 column pairs (name + indicator), fills remaining space -->
    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:columnCount="3"
        android:paddingTop="4dp" />

</LinearLayout>
