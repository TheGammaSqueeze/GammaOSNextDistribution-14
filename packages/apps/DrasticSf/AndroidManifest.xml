<?xml version="1.0" encoding="utf-8"?>
<!-- DrasticSf: the SurfaceFlinger host activity for drastic-nano. The XMB
     am-starts this for a DS ROM when persist.gammaos.drastic_nano.backend=sf. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gammaos.drasticsf">

    <application
        android:allowBackup="false"
        android:label="DraStic"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".DrasticSfActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode|navigation">

            <!-- No LAUNCHER category: this is the SurfaceFlinger host for drastic-nano, not a
                 user-facing app, so it must not show a drawer icon in normal Android. nano starts
                 it by explicit component (-n com.gammaos.drasticsf/.DrasticSfActivity -a MAIN),
                 which resolves on MAIN alone and does not need LAUNCHER. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
