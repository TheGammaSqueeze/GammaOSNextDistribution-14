<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_launch_guard"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchLaunchGuard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_guard_toggle_label"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/switchSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launch_guard_toggle_summary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/callersTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/callers_section_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/callersHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/callers_section_hint"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCallers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/targetsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/targets_section_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/targetsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/targets_section_hint"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTargets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
