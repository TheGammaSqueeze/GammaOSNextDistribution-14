<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ColorPreset" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/preset_border</item>
    </style>
    <style name="Widget.TargetButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <!-- slightly smaller pill buttons -->
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/preset_border</item>
    </style>
</resources>
