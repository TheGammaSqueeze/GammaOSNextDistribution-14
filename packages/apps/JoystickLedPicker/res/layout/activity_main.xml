<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Compact title bar with inline color preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_joystick_led"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/preview_color"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="14dp"
            app:cardUseCompatPadding="false" />

        <TextView
            android:id="@+id/preview_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview (#000000)"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main content: left wheel, right controls -->
    <LinearLayout
        android:id="@+id/colorWheelContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp">

        <!-- Left: color wheel fills all available space -->
        <LinearLayout
            android:id="@+id/left_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.gammaos.joystickled.ui.ColorWheelView
                android:id="@+id/color_wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </LinearLayout>

        <!-- Right: scrollable controls, fills viewport when content fits -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/right_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- LED Effects -->
                <TextView
                    android:id="@+id/label_custom_effects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_custom_effects"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layout_custom_effects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1: Screen RGB + Solid + Off -->
                    <LinearLayout
                        android:id="@+id/layout_custom_effects_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect_follow"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="3"
                            android:text="@string/effect_follow_screen"
                            android:layout_marginEnd="4dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect_none"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_none"
                            android:layout_marginEnd="4dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect_off"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_off"
                            android:maxLines="1"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Row 2: E1-E5 -->
                    <LinearLayout
                        android:id="@+id/layout_custom_effects_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect1"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_1"
                            android:layout_marginEnd="2dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect2"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_2"
                            android:layout_marginEnd="2dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect3"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_3"
                            android:layout_marginEnd="2dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect4"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_4"
                            android:layout_marginEnd="2dp"
                            android:maxLines="1"
                            android:singleLine="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_effect5"
                            style="@style/Widget.TargetButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/effect_5"
                            android:maxLines="1"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Color Options -->
                <TextView
                    android:id="@+id/label_color_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_color_options"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_white"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_yellow"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_orange"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_pink"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_red"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_blue"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_green"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_purple"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_cyan"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_magenta"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_amber"
                        style="@style/Widget.ColorPreset" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preset_teal"
                        style="@style/Widget.ColorPreset" />
                </LinearLayout>

                <!-- Control Targets -->
                <TextView
                    android:id="@+id/label_control_targets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_control_targets"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layout_control_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_both"
                        style="@style/Widget.TargetButton"
                        android:text="@string/target_both"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_left"
                        style="@style/Widget.TargetButton"
                        android:text="@string/target_left"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_right"
                        style="@style/Widget.TargetButton"
                        android:text="@string/target_right"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_primary"
                        style="@style/Widget.TargetButton"
                        android:text="@string/target_primary"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_follow"
                        style="@style/Widget.TargetButton"
                        android:text="@string/target_follow"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Toggles row: split colors + follow brightness -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/label_split_colors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/label_split_colors"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/label_follow_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/label_follow_brightness"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_follow_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Color Brightness -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/label_brightness"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="35"
                        android:text="@string/label_brightness"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/brightness_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="55"
                        android:background="@android:color/transparent"
                        android:thumbOffset="0dp"
                        android:splitTrack="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/gamma_slider_track"
                        android:thumb="@drawable/gamma_slider_thumb" />

                    <TextView
                        android:id="@+id/brightness_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="10"
                        android:gravity="end"
                        android:text="27%"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Color Saturation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/label_saturation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="35"
                        android:text="@string/label_saturation"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/saturation_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="55"
                        android:background="@android:color/transparent"
                        android:thumbOffset="0dp"
                        android:splitTrack="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/gamma_slider_track"
                        android:thumb="@drawable/gamma_slider_thumb" />

                    <TextView
                        android:id="@+id/saturation_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="10"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Effect Speed (hidden by default) -->
                <LinearLayout
                    android:id="@+id/layout_effect_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/label_effect_speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="35"
                        android:text="@string/label_effect_speed"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/effect_speed_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="55"
                        android:background="@android:color/transparent"
                        android:thumbOffset="0dp"
                        android:splitTrack="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/gamma_slider_track"
                        android:thumb="@drawable/gamma_slider_thumb" />

                    <TextView
                        android:id="@+id/effect_speed_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="10"
                        android:gravity="end"
                        android:text="10"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- LED Brightness (hidden by default) -->
                <LinearLayout
                    android:id="@+id/layout_led_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/label_led_brightness"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="35"
                        android:text="@string/label_led_brightness"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/led_brightness_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="55"
                        android:background="@android:color/transparent"
                        android:thumbOffset="0dp"
                        android:splitTrack="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/gamma_slider_track"
                        android:thumb="@drawable/gamma_slider_thumb" />

                    <TextView
                        android:id="@+id/led_brightness_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="10"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
