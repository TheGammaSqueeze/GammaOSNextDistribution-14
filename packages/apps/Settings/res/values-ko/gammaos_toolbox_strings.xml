    <string name="gammaos_toolbox_shader_lcd3x_brighten_scan_title">스캔라인 밝기</string>
    <string name="gammaos_toolbox_shader_lcd3x_brighten_scan_summary">스캔라인 밝기 배율. 기본값: 4.0.</string>
    <string name="gammaos_toolbox_shader_lcd3x_brighten_lcd_title">LCD 밝기</string>
    <string name="gammaos_toolbox_shader_lcd3x_brighten_lcd_summary">전체 LCD 밝기 배율. 기본값: 4.0.</string>
