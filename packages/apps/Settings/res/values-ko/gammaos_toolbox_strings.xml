    <string name="gammaos_toolbox_shader_lcd3x_grid_x_summary">서브픽셀 그리드의 수평 크기. 기본값: 4.0.</string>
    <string name="gammaos_toolbox_shader_lcd3x_grid_y_title">그리드 픽셀 높이</string>
    <string name="gammaos_toolbox_shader_lcd3x_grid_y_summary">서브픽셀 그리드의 수직 크기. 기본값: 4.0.</string>

    <string name="gammaos_toolbox_category_shader_lcd">LCD 셰이더</string>
    <string name="gammaos_toolbox_category_shader_lcd_description">응답 시간 시뮬레이션, 서브픽셀 렌더링, 스캔라인 효과가 있는 LCD 셰이더. LCD3x보다 더 고급입니다.</string>
    <string name="gammaos_toolbox_shader_lcd_half_res_title">절반 해상도</string>
    <string name="gammaos_toolbox_shader_lcd_half_res_summary">더 나은 성능을 위해 LCD 셰이더를 절반 해상도로 렌더링합니다.</string>
    <string name="gammaos_toolbox_shader_lcd_response_title">응답 시간</string>
    <string name="gammaos_toolbox_shader_lcd_response_summary">시뮬레이션 LCD 응답 시간(0.0\u20130.78). 기본값: 0. 높은 값은 모션 블러를 추가합니다.</string>
    <string name="gammaos_toolbox_shader_lcd_scan_strength_title">스캔 강도</string>
    <string name="gammaos_toolbox_shader_lcd_scan_strength_summary">스캔라인 가시성(0.0\u20131.0). 기본값: 0.20.</string>
    <string name="gammaos_toolbox_shader_lcd_subpixel_title">서브픽셀 강도</string>
    <string name="gammaos_toolbox_shader_lcd_subpixel_summary">RGB 서브픽셀 그리드 강도(0.0\u20131.0). 기본값: 0.40.</string>
    <string name="gammaos_toolbox_shader_lcd_gap_strength_title">간격 강도</string>
    <string name="gammaos_toolbox_shader_lcd_gap_strength_summary">픽셀 간 간격 어둡기(0.0\u20131.0). 기본값: 0.10.</string>
    <string name="gammaos_toolbox_shader_lcd_gap_px_title">간격 크기 (px)</string>
    <string name="gammaos_toolbox_shader_lcd_gap_px_summary">픽셀 간 간격 너비(0.0\u20130.45). 기본값: 0.05.</string>

    <string name="gammaos_toolbox_category_shader_blurfill">블러 채우기 셰이더</string>
    <string name="gammaos_toolbox_category_shader_blurfill_description">레터박스/필러박스 바를 검은 바 대신 블러 처리된 게임 콘텐츠로 채웁니다.</string>
    <string name="gammaos_toolbox_shader_blurfill_sigma_title">블러 시그마</string>
    <string name="gammaos_toolbox_shader_blurfill_sigma_summary">가우시안 블러 반경(0.1\u201364.0). 기본값: 12.0. 높을수록 더 흐려집니다.</string>
