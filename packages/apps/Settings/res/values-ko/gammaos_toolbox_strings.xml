    <string name="gammaos_toolbox_taskbar_dual_summary">멀티 디스플레이 모드에서 두 디스플레이 모두에 작업 표시줄을 표시합니다.</string>
    <string name="gammaos_toolbox_wallpaper_multidisplay_title">멀티 디스플레이 배경화면</string>
    <string name="gammaos_toolbox_wallpaper_multidisplay_summary">모든 연결된 디스플레이에서 배경화면을 강제로 렌더링합니다.</string>

    <string name="gammaos_toolbox_qs_override_title">기본 QS 타일 재정의</string>
