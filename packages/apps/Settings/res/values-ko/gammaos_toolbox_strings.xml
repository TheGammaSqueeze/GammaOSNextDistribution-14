    <string name="gammaos_toolbox_shader_custom_res_scale_summary">사용자 지정 셰이더의 다운스케일 팩터. 값: 1/2, 1/3, 1/4 또는 소수.</string>

    <string name="gammaos_toolbox_dualstack_blast_tune_title">BLAST 버퍼 튜닝</string>
    <string name="gammaos_toolbox_dualstack_blast_tune_summary">듀얼 스택 모드의 BLAST 버퍼 큐 튜닝을 활성화합니다.</string>
    <string name="gammaos_toolbox_dualstack_blast_async_title">BLAST 비동기 모드</string>
    <string name="gammaos_toolbox_dualstack_blast_async_summary">듀얼 스택 BLAST 모드에서 비동기 버퍼 제출을 사용합니다.</string>

    <string name="gammaos_toolbox_category_power">전원 및 성능</string>
    <string name="gammaos_toolbox_category_power_description">전원 관리, 팬 제어 및 프로세스 제한. 배터리 수명, 발열 동작 및 시스템 응답성에 영향을 줍니다.</string>
    <string name="gammaos_toolbox_fan_mode_title">팬 모드</string>
    <string name="gammaos_toolbox_fan_mode_summary">능동 냉각 기기의 팬 제어 프로파일. 기기별 값.</string>
    <string name="gammaos_toolbox_ultra_low_power_title">초저전력 모드</string>
    <string name="gammaos_toolbox_ultra_low_power_summary">딥 슬립/초저전력 절전 모드를 활성화합니다. 백그라운드 앱을 적극적으로 동결합니다.</string>
    <string name="gammaos_toolbox_ultra_low_power_exclude_title">저전력 동결 제외</string>
    <string name="gammaos_toolbox_ultra_low_power_exclude_summary">초저전력 모드에서 프로세스 동결에서 제외할 패키지 이름의 쉼표로 구분된 목록.</string>

    <string name="gammaos_toolbox_category_retro">RetroArch 및 에뮬레이션</string>
    <string name="gammaos_toolbox_category_retro_description">RetroArch 및 에뮬레이션에 특화된 재정의. 뒤로 버튼 동작과 레트로 스타일 기기의 LED 표시를 제어합니다.</string>
    <string name="gammaos_toolbox_retroarch_backbutton_title">RetroArch 뒤로 버튼 재정의</string>
    <string name="gammaos_toolbox_retroarch_backbutton_summary">RetroArch 내 뒤로 버튼 동작을 재정의합니다. 0 = 기본값, 1 = 재정의.</string>
    <string name="gammaos_toolbox_startselectled_title">Start/Select LED 표시</string>
    <string name="gammaos_toolbox_startselectled_summary">레트로 스타일 기기에서 Start/Select 버튼의 LED 표시를 활성화합니다.</string>

    <string name="gammaos_toolbox_category_usb">USB 및 도킹</string>
    <string name="gammaos_toolbox_category_usb_description">USB 컨트롤러 모드 전환 및 디스플레이 도킹 동작. USB 주변기기 및 도킹 모드 처리 방식에 영향을 줍니다.</string>
    <string name="gammaos_toolbox_usb_controller_switch_title">USB 컨트롤러 모드 전환</string>
    <string name="gammaos_toolbox_usb_controller_switch_summary">도킹/언도킹 시 USB 컨트롤러 모드를 자동으로 전환합니다.</string>
    <string name="gammaos_toolbox_dc_dimming_title">DC 디밍 에뮬레이션</string>
