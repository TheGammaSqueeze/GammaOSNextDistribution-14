// GammaOS SecondaryHome: the secondary-display home in normal Android mode, a port of the
// nano Control Centre (dashboard, application grid, screen options) to a single Activity.
android_app {
    name: "SecondaryHome",

    srcs: [
        "java/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    privileged: false,

    static_libs: [
        "com.google.android.material_material",
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.recyclerview_recyclerview",
        "androidx-constraintlayout_constraintlayout",
    ],
}
