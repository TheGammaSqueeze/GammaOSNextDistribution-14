<?xml version="1.0" encoding="utf-8"?>
<!-- GammaOS SecondaryHome: minimal launcher for the secondary display on the TV/desktop build.
     It only ever runs when the secondary display is granted system decorations (desktop mode);
     in nano/handheld mode no secondary home is started, so this app stays inert. It advertises
     SECONDARY_HOME (not HOME/LAUNCHER) so it never competes for the primary home and never shows
     as a drawer icon. persist.gammaos.secondary_home points at it explicitly. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gammaos.secondaryhome">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecondaryHome">

        <activity
            android:name=".SecondaryHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
