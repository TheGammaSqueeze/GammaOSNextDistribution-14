<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xmb_background">

    <!-- Browser content: toolbar + progress + page -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- XMB-style translucent toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/xmb_bar"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_back" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_forward"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_forward" />

            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_reload"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_reload" />

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/field_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="@color/xmb_text"
                android:textColorHint="@color/xmb_hint"
                android:textSize="15sp"
                android:hint="@string/hint_address"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btn_go"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_go"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_go" />

            <ImageButton
                android:id="@+id/btn_star"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_star"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_bookmark" />

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_bookmarks"
                android:background="@drawable/btn_bg"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:focusable="true"
                android:contentDescription="@string/cd_menu" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/xmb_progress"
            android:progressBackgroundTint="@color/xmb_progress_track"
            android:visibility="gone" />

        <com.gammaos.browser.NoImeWebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- In-app gamepad cursor. Painted over the page but under the panel scrim.
         Non-focusable / non-clickable so it never steals d-pad focus or eats touch.
         GONE (zero cost) until Y turns on mouse mode. -->
    <com.gammaos.browser.CursorView
        android:id="@+id/cursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:visibility="gone" />

    <!-- Bookmarks / history overlay: a dimmed scrim with a centered XMB card.
         Hidden until the menu button or SELECT opens it. -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/xmb_scrim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/panel_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="36dp"
            android:layout_marginRight="36dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:orientation="vertical"
            android:background="@drawable/panel_bg"
            android:clickable="true"
            android:padding="14dp">

            <!-- Header: Bookmarks / History tabs + Desktop-site toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/tab_bookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_bg"
                    android:text="@string/tab_bookmarks"
                    android:textColor="@color/xmb_text"
                    android:textAllCaps="false"
                    android:focusable="true" />

                <Button
                    android:id="@+id/tab_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_bg"
                    android:text="@string/tab_history"
                    android:textColor="@color/xmb_hint"
                    android:textAllCaps="false"
                    android:focusable="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_desktop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_bg"
                    android:text="@string/desktop_off"
                    android:textColor="@color/xmb_text"
                    android:textAllCaps="false"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/xmb_divider" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/xmb_divider"
                    android:dividerHeight="1dp"
                    android:listSelector="@color/xmb_list_sel"
                    android:drawSelectorOnTop="true"
                    android:focusable="true"
                    android:cacheColorHint="#00000000" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/xmb_hint"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/panel_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/panel_hint"
                android:textColor="@color/xmb_hint"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
