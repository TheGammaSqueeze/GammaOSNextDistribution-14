<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state (touch) -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/reset_purple_highlight" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Focused state (D-pad / joypad highlight) -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/reset_purple_highlight" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/colorAccent" />
        </shape>
    </item>

    <!-- Default: pale purple -->
    <item>
        <shape>
            <solid android:color="@color/reset_purple_normal" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>
