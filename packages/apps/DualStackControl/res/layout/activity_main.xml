<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
 
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/togglesGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_dualstack"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchDualstack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dualstack_toggle_label"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" />
 
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchSurfaceViewOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/surfaceview_only_toggle_label"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/switchDualstack" />

    <TextView
        android:id="@+id/switchSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dualstack_toggle_summary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/switchDualstack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/togglesGuideline" />

    <TextView
        android:id="@+id/switchSummarySurfaceViewOnly"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/surfaceview_only_toggle_summary"
        android:textSize="12sp"
        android:gravity="end"
        android:textAlignment="viewEnd"
        app:layout_constraintTop_toBottomOf="@id/switchSurfaceViewOnly"
        app:layout_constraintStart_toEndOf="@id/togglesGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/toggleSummariesBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="switchSummary,switchSummarySurfaceViewOnly" />

    <TextView
        android:id="@+id/appsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/apps_section_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/toggleSummariesBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/appsHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/apps_section_hint"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/appsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/appsHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
