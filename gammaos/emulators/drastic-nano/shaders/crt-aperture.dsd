<?xml version="1.0" encoding="UTF-8"?>
<!--
   CRT Shader by EasyMode (RetroArch crt/shaders/crt-aperture.glsl)
   License: GPL
   drastic-nano port: the integer output scale, the even-scale half-pixel
   scanline offset and the scanline phase are computed in DS pixel space (256x192)
   instead of the input texture size, so hi-res 3D does not double the
   scanlines; the gaussian and lanczos texel fetches keep the real texture size.
   The aperture mask stays keyed to output pixels. The sampler2D function
   parameters were replaced by the u_texture uniform (same fetches).
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	uniform vec4 u_texture_size;
	uniform vec2 u_target_size;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters (defaults) */
	const float SHARPNESS_IMAGE = 1.0;     /* Sharpness Image 1.0 .. 5.0 */
	const float SHARPNESS_EDGES = 3.0;     /* Sharpness Edges 1.0 .. 5.0 */
	const float GLOW_WIDTH = 0.5;          /* Glow Width 0.05 .. 0.65 */
	const float GLOW_HEIGHT = 0.5;         /* Glow Height 0.05 .. 0.65 */
	const float GLOW_HALATION = 0.1;       /* Glow Halation 0.0 .. 1.0 */
	const float GLOW_DIFFUSION = 0.05;     /* Glow Diffusion 0.0 .. 1.0 */
	const float MASK_COLORS = 2.0;         /* Mask Colors 2.0 .. 3.0 */
	const float MASK_STRENGTH = 0.3;       /* Mask Strength 0.0 .. 1.0 */
	const float MASK_SIZE = 1.0;           /* Mask Size 1.0 .. 9.0 */
	const float SCANLINE_SIZE_MIN = 0.5;   /* Scanline Size Min. 0.5 .. 1.5 */
	const float SCANLINE_SIZE_MAX = 1.5;   /* Scanline Size Max. 0.5 .. 1.5 */
	const float SCANLINE_SHAPE = 2.5;      /* Scanline Shape 1.0 .. 100.0 */
	const float SCANLINE_OFFSET = 1.0;     /* Scanline Offset 0.0 .. 1.0 */
	const float GAMMA_INPUT = 2.4;         /* Gamma Input 1.0 .. 5.0 */
	const float GAMMA_OUTPUT = 2.4;        /* Gamma Output 1.0 .. 5.0 */
	const float BRIGHTNESS = 1.5;          /* Brightness 0.0 .. 2.0 */

	const float PI = 3.141592653589;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	vec3 TEX2D(vec2 c) {
		return pow(texture2D(u_texture, c).rgb, vec3(GAMMA_INPUT));
	}

	mat3 get_color_matrix(vec2 co, vec2 dx) {
		return mat3(TEX2D(co - dx), TEX2D(co), TEX2D(co + dx));
	}

	vec3 blur(mat3 m, float dist, float rad) {
		vec3 x = vec3(dist - 1.0, dist, dist + 1.0) / rad;
		vec3 w = exp2(x * x * -1.0);
		return (m[0] * w.x + m[1] * w.y + m[2] * w.z) / (w.x + w.y + w.z);
	}

	vec3 filter_gaussian(vec2 co, vec2 tex_size) {
		vec2 dx = vec2(1.0 / tex_size.x, 0.0);
		vec2 dy = vec2(0.0, 1.0 / tex_size.y);
		vec2 pix_co = co * tex_size;
		vec2 tex_co = (floor(pix_co) + 0.5) / tex_size;
		vec2 dist = (fract(pix_co) - 0.5) * -1.0;

		mat3 line0 = get_color_matrix(tex_co - dy, dx);
		mat3 line1 = get_color_matrix(tex_co, dx);
		mat3 line2 = get_color_matrix(tex_co + dy, dx);
		mat3 column = mat3(blur(line0, dist.x, GLOW_WIDTH),
		                   blur(line1, dist.x, GLOW_WIDTH),
		                   blur(line2, dist.x, GLOW_WIDTH));

		return blur(column, dist.y, GLOW_HEIGHT);
	}

	vec3 filter_lanczos(vec2 co, vec2 tex_size, float sharp) {
		tex_size.x *= sharp;

		vec2 dx = vec2(1.0 / tex_size.x, 0.0);
		vec2 pix_co = co * tex_size - vec2(0.5, 0.0);
		vec2 tex_co = (floor(pix_co) + vec2(0.5, 0.0)) / tex_size;
		vec2 dist = fract(pix_co);
		vec4 coef = PI * vec4(dist.x + 1.0, dist.x, dist.x - 1.0, dist.x - 2.0);

		coef = max(abs(coef), 1e-5);
		coef = 2.0 * sin(coef) * sin(coef / 2.0) / (coef * coef);
		coef /= dot(coef, vec4(1.0));

		vec4 col1 = vec4(TEX2D(tex_co), 1.0);
		vec4 col2 = vec4(TEX2D(tex_co + dx), 1.0);

		return (mat4(col1, col1, col2, col2) * coef).rgb;
	}

	vec3 get_scanline_weight(float x, vec3 col) {
		vec3 beam = mix(vec3(SCANLINE_SIZE_MIN), vec3(SCANLINE_SIZE_MAX), pow(col, vec3(1.0 / SCANLINE_SHAPE)));
		vec3 x_mul = 2.0 / beam;
		vec3 x_offset = x_mul * 0.5;

		return smoothstep(0.0, 1.0, 1.0 - abs(x * x_mul - x_offset)) * x_offset;
	}

	/* mask keyed to output pixels (TextureSize / InputSize = 1.0) */
	vec3 get_mask_weight(float x) {
		float i = mod(floor(x * u_target_size.x / MASK_SIZE), MASK_COLORS);

		if (i == 0.0) return mix(vec3(1.0, 0.0, 1.0), vec3(1.0, 0.0, 0.0), MASK_COLORS - 2.0);
		else if (i == 1.0) return vec3(0.0, 1.0, 0.0);
		else return vec3(0.0, 0.0, 1.0);
	}

	void main() {
		/* integer scale of output lines per DS line, and the even-scale
		   half-pixel scanline offset (in DS lines) */
		float scale = floor((u_target_size.y / DS_SCREEN.y) + 0.001);
		float offset = 1.0 / scale * 0.5;

		if (mod(scale, 2.0) != 0.0) offset = 0.0;

		vec2 co = v_texture_coordinate - vec2(0.0, offset * SCANLINE_OFFSET / DS_SCREEN.y);

		/* texel addressing */
		vec3 col_glow = filter_gaussian(co, u_texture_size.zw);
		vec3 col_soft = filter_lanczos(co, u_texture_size.zw, SHARPNESS_IMAGE);
		vec3 col_sharp = filter_lanczos(co, u_texture_size.zw, SHARPNESS_EDGES);
		vec3 col = sqrt(col_sharp * col_soft);

		/* scanline phase: DS line space */
		col *= get_scanline_weight(fract(co.y * DS_SCREEN.y), col_soft);
		col_glow = clamp(col_glow - col, 0.0, 1.0);
		col += col_glow * col_glow * GLOW_HALATION;
		col = mix(col, col * get_mask_weight(co.x) * MASK_COLORS, MASK_STRENGTH);
		col += col_glow * GLOW_DIFFUSION;
		col = pow(col * BRIGHTNESS, vec3(1.0 / GAMMA_OUTPUT));

		gl_FragColor = vec4(col, 1.0);
	}
</fragment>
