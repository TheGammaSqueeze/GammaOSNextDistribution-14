<?xml version="1.0" encoding="UTF-8"?>
<!--
   Author: Gigaherz
   License: Public domain
-->
<options>
filter=nearest
</options>

<vertex>
	uniform vec4 u_texture_size;
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;
	varying vec2 omega;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
		omega = vec2(3.141592654 * 2.0 * u_texture_size.z, 3.141592654 * 2.0 * u_texture_size.w);
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	varying vec2 v_texture_coordinate;
	varying vec2 omega;

	/* configuration (higher values mean brighter image but reduced effect depth) */
	const float brighten_scanlines = 16.0;
	const float brighten_lcd = 4.0;

	const vec3 offsets = 3.141592654 * vec3(1.0/2.0,1.0/2.0 - 2.0/3.0,1.0/2.0-4.0/3.0);

	void main() {
		vec2 angle = v_texture_coordinate * omega;

		float yfactor = (brighten_scanlines + sin(angle.y)) / (brighten_scanlines + 1.0);
		vec3 xfactors = (brighten_lcd + sin(angle.x + offsets)) / (brighten_lcd + 1.0);

		gl_FragColor.rgb = yfactor * xfactors * texture2D(u_texture, v_texture_coordinate).rgb;
	}
</fragment>
