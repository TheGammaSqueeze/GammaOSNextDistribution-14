<?xml version="1.0" encoding="UTF-8"?>
<!--
   lcd3x shader (RetroArch handheld/shaders/lcd3x.glsl)
   Author: Gigaherz
   License: Public domain
   drastic-nano port: the grid is generated in DS pixel space (256x192) instead
   of the input texture size, so hi-res 3D and Half Resolution do not change it.
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters (higher values mean a brighter image but a shallower effect) */
	const float brighten_scanlines = 16.0;   /* 1.0 .. 32.0 */
	const float brighten_lcd = 4.0;          /* 1.0 .. 12.0 */

	const float PI = 3.141592654;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);
	const vec3 offsets = vec3(PI) * vec3(1.0 / 2.0, 1.0 / 2.0 - 2.0 / 3.0, 1.0 / 2.0 - 4.0 / 3.0);

	void main() {
		vec2 omega = vec2(PI) * vec2(2.0) * DS_SCREEN;
		vec3 res = texture2D(u_texture, v_texture_coordinate).rgb;
		vec2 angle = v_texture_coordinate * omega;
		float yfactor = (brighten_scanlines + sin(angle.y)) / (brighten_scanlines + 1.0);
		vec3 xfactors = (brighten_lcd + sin(angle.x + offsets)) / (brighten_lcd + 1.0);
		gl_FragColor = vec4(yfactor * xfactors * res, 1.0);
	}
</fragment>
