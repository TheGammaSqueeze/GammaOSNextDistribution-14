// dot: RetroArch handheld/dot (Themaister, public domain): each source pixel
// becomes a round glowing dot with an exponential falloff, blended with its
// eight neighbours. Ported for drastic-nano: one pass at the panel resolution,
// NEAREST fetch, the dot grid in DS pixel space (256x192) so hi-res 3D does not
// double it.
=============================================
<options>
name=dot
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=dot.dsd
sampler:u_texture=0
</pass>
