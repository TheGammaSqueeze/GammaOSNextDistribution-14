// LCD1x: RetroArch handheld/lcd1x (jdgleaver's tweak of Gigaherz's lcd3x, GPL v2):
// a sine scanline and pixel grid with no colour separation, scanlines aligned
// between DS pixels (the 0.25 pixel offset). Ported for drastic-nano: one pass
// at the panel resolution, NEAREST fetch, the grid in DS pixel space (256x192)
// so it is right under hi-res 3D (512x384 input) and Half Resolution alike.
=============================================
<options>
name=LCD1x
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=lcd1x.dsd
sampler:u_texture=0
</pass>
