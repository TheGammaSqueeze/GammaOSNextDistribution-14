// zfast-lcd: RetroArch handheld/zfast-lcd (Greg Hogan / SoltanGris42, GPL v2):
// nearest-neighbour pixels with darkened borders imitating an LCD, plus the
// "GBA gamma hack". Ported for drastic-nano: one pass at the panel resolution,
// LINEAR fetch as the preset requests, the pixel cells in DS pixel space
// (256x192) so hi-res 3D does not double the grid.
=============================================
<options>
name=zfast-lcd
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=zfast-lcd.dsd
sampler:u_texture=0
</pass>
