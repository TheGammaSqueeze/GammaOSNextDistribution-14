// crt-hyllian-fast: RetroArch crt/crt-hyllian-fast (Hyllian, MIT; GLSL by
// metallic77): horizontal cubic reconstruction, smoothstep beam scanline with
// bright boost, cgwg's magenta/green dot mask keyed to output pixels, fast squared
// gamma. Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch,
// the scanline phase in DS pixel space (256x192), texel snapping on the real input.
=============================================
<options>
name=crt-hyllian-fast
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=crt-hyllian-fast.dsd
sampler:u_texture=0
</pass>
