// crt-mattias: RetroArch crt/crt-mattias (Mattias' Shadertoy CRT emulation): a
// curved, blurred, chromatically split and vignetted tube with crawling scanlines,
// flicker and noise. Ported for drastic-nano: one pass at the panel resolution,
// NEAREST fetch, the frame counter derived from u_time; the blur radius, the
// scanline crawl and the column mask are keyed to output pixels as in the original.
=============================================
<options>
name=crt-mattias
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=crt-mattias.dsd
sampler:u_texture=0
</pass>
