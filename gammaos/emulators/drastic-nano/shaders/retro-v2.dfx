// retro-v2: RetroArch handheld/retro-v2 (Hyllian and DOLLS, GPL v2): nearest
// pixels with a dark gap between them (the "retro pixel" look), gamma-correct,
// the gap width anti-aliased over the output pixel. Ported for drastic-nano: one
// pass at the panel resolution, NEAREST fetch, the pixel cells in DS pixel space
// (256x192) so hi-res 3D does not double them.
=============================================
<options>
name=retro-v2
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=retro-v2.dsd
sampler:u_texture=0
</pass>
