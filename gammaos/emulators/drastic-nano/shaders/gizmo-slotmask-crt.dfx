// gizmo-slotmask-crt: RetroArch crt/gizmo-slotmask-crt, ported for drastic-nano: one pass at the panel
// resolution, LINEAR fetch, scanline phase in DS pixel space (256x192), slot mask on output pixels.
=============================================
<options>
name=gizmo-slotmask-crt
textures=1
</options>

<fheader>
#extension GL_OES_standard_derivatives : enable
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=gizmo-slotmask-crt.dsd
sampler:u_texture=0
</pass>
