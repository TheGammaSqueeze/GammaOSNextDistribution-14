// sameboy-lcd: RetroArch handheld/sameboy-lcd (LIJI32 / Lior Halphon, MIT): the
// SameBoy LCD filter, a 6x6 subpixel layout per pixel with colour bleed from the
// neighbouring pixels and a soft scanline between rows. Ported for drastic-nano:
// one pass at the panel resolution, NEAREST fetch, the pixel/subpixel grid in DS
// pixel space (256x192) so hi-res 3D does not double it.
=============================================
<options>
name=sameboy-lcd
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=sameboy-lcd.dsd
sampler:u_texture=0
</pass>
