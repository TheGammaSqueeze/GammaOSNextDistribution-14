<?xml version="1.0" encoding="UTF-8"?>
<!--
   crt-hyllian-fast shader (RetroArch crt/shaders/hyllian/crt-hyllian-fast.glsl)
   Hyllian's CRT Shader
   with cgwg's magenta/green dotmask
   ported to GLSL by metallic77

   Copyright (C) 2011-2015 Hyllian - sergiogdb@gmail.com

   Permission is hereby granted, free of charge, to any person obtaining a copy
   of this software and associated documentation files (the "Software"), to deal
   in the Software without restriction, including without limitation the rights
   to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
   copies of the Software, and to permit persons to whom the Software is
   furnished to do so, subject to the following conditions:

   The above copyright notice and this permission notice shall be included in
   all copies or substantial portions of the Software.

   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
   THE SOFTWARE.

   drastic-nano port: the scanline phase (fract of the source row) is computed in
   DS pixel space (256x192) instead of the input texture size, so hi-res 3D does not
   double the scanlines; the half-texel shift, the texel-centre snap and the cubic
   tap weights/offsets keep the real input texture size. The dot mask stays keyed to
   output pixels. Parameter values are the #pragma defaults RetroArch uses.
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	uniform vec4 u_texture_size;
	uniform vec2 u_target_size;
	varying vec2 v_texture_coordinate;
	varying vec2 ps;
	varying float mod_factor;
	varying float MASK;

	/* RetroArch parameters */
	const float SHARPNESS = 1.0;       /* SHARPNESS 1.0 .. 2.0 */
	const float MASK_INTENSITY = 0.5;  /* MASK INTENSITY 0.0 .. 1.0 */

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		vec2 tex_size = vec2(u_texture_size.z * SHARPNESS, u_texture_size.w);
		ps = 1.0 / tex_size;
		v_texture_coordinate = a_texture_coordinate.xy + ps * vec2(-0.49999, 0.0);
		mod_factor = v_texture_coordinate.x * u_target_size.x;
		MASK = 1.0 - MASK_INTENSITY;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	uniform vec4 u_texture_size;
	varying vec2 v_texture_coordinate;
	varying vec2 ps;
	varying float mod_factor;
	varying float MASK;

	/* RetroArch parameters */
	const float InputGamma = 2.4;    /* INPUT GAMMA 0.0 .. 5.0 */
	const float OutputGamma = 2.2;   /* OUTPUT GAMMA 0.0 .. 5.0 */
	const float BRIGHTBOOST = 1.5;   /* BRIGHT BOOST 1.0 .. 2.0 */
	const float SCANLINES = 0.72;    /* SCANLINES STRENGTH 0.0 .. 1.0 */

	/* much faster Gamma, gain a ton of fps */
	const float FAKE_GAMMA = 1.0;

	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	vec3 gamma_in(vec3 color) {
		return (FAKE_GAMMA == 1.0) ? color * color : pow(color, vec3(InputGamma));
	}

	vec3 gamma_out(vec3 color) {
		return (FAKE_GAMMA == 1.0) ? sqrt(color) : pow(color, vec3(1.0 / OutputGamma));
	}

	void main()
	{
		vec2 dx = vec2(ps.x, 0.0);
		vec2 dy = vec2(0.0, ps.y);

		/* texel addressing: snap to the real input texel grid */
		vec2 tc = (floor(v_texture_coordinate.xy * u_texture_size.zw) + vec2(0.49999, 0.0)) * u_texture_size.xy;

		/* fp.x: sub-texel position for the cubic taps (real texels);
		   fp.y: scanline phase, source-pixel period in DS pixel space */
		vec2 fp = vec2(fract(v_texture_coordinate.x * u_texture_size.z),
		               fract(v_texture_coordinate.y * DS_SCREEN.y));

		vec3 c10 = texture2D(u_texture, tc -       dx).xyz;
		c10 = gamma_in(c10);
		vec3 c11 = texture2D(u_texture, tc           ).xyz;
		c11 = gamma_in(c11);
		vec3 c12 = texture2D(u_texture, tc +       dx).xyz;
		c12 = gamma_in(c12);
		vec3 c13 = texture2D(u_texture, tc + 2.0 * dx).xyz;
		c13 = gamma_in(c13);
		float FF = fp.x * fp.x;
		vec4 lobes = vec4(FF * fp.x, FF, fp.x, 1.0);

		vec4 InvX = vec4(0.0);
		/* Horizontal cubic filter */
		InvX.x = dot(vec4(-0.5,  1.0, -0.5, 0.0), lobes);
		InvX.y = dot(vec4( 1.5, -2.5,  0.0, 1.0), lobes);
		InvX.z = dot(vec4(-1.5,  2.0,  0.5, 0.0), lobes);
		InvX.w = dot(vec4( 0.5, -0.5,  0.0, 0.0), lobes);

		vec3 color = InvX.x * c10.xyz;
		color += InvX.y * c11.xyz;
		color += InvX.z * c12.xyz;
		color += InvX.w * c13.xyz;

		color = clamp(color, vec3(0.0), vec3(1.0));

		/* for smoothstep (initially) to work we need a 0 to 1 range,
		   and 0 being the center of the "beam" */
		float pos1 = 1.0 - abs(fp.y * 2.0 - 1.0); /* now 0 is our center */
		float d1 = pos1;
		float d  = d1 * d1 * (3.0 - (2.0 * d1)); /* smoothstep */
		color *= SCANLINES * d * BRIGHTBOOST + 1.0 - SCANLINES;
		/* dotmask */
		vec3 dotMaskWeights = mix(
			vec3(1.0, MASK, 1.0),
			vec3(MASK, 1.0, MASK),
			mod(floor(mod_factor), 2.0)
		);
		color *= dotMaskWeights;

		color = gamma_out(color);

		gl_FragColor = vec4(color.r, color.g, color.b, 1.0);
	}
</fragment>
