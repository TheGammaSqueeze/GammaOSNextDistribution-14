// crt-gdv-mini: RetroArch crt/crt-gdv-mini, ported for drastic-nano: one pass at the panel
// resolution, LINEAR fetch, scanline phase in DS pixel space (256x192), mask on output pixels.
=============================================
<options>
name=crt-gdv-mini
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=crt-gdv-mini.dsd
sampler:u_texture=0
</pass>
