// crt-aperture: RetroArch crt/crt-aperture, ported for drastic-nano: one pass at the panel
// resolution, NEAREST fetch, scanline phase in DS pixel space (256x192), mask on output pixels.
=============================================
<options>
name=crt-aperture
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=crt-aperture.dsd
sampler:u_texture=0
</pass>
