   of this software and associated documentation files (the "Software"), to deal
   in the Software without restriction, including without limitation the rights
   to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
   copies of the Software, and to permit persons to whom the Software is
   furnished to do so, subject to the following conditions:

   The above copyright notice and this permission notice shall be included in
   all copies or substantial portions of the Software.

   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
   THE SOFTWARE.

   drastic-nano port: the sub-pixel position (which shapes both the pixel window
   and the scanline) and the matching neighbour offsets are computed in DS pixel
   space (256x192) instead of the input texture size, so hi-res 3D does not double
   the scanlines. The weights and the neighbour fetch are one coupled filter, so the
   offsets follow the same grid (one DS pixel; under hi-res 3D that is two texels).
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;
	varying vec4 t1;
	varying float pix_sizex;
	varying float scan_sizey;

	/* RetroArch parameters */
	const float VSCANLINES = 0.0;   /* Vertical Scanlines 0.0 .. 1.0 */
	const float SCAN_SIZE = 0.86;   /* Scanlines Size 0.0 .. 2.0 */

	const float PIX_SIZE = 1.11;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;

		pix_sizex  = mix(PIX_SIZE, SCAN_SIZE, VSCANLINES);
		scan_sizey = mix(SCAN_SIZE, PIX_SIZE, VSCANLINES);

		vec2 ps = 1.0 / DS_SCREEN;
		float dx = ps.x;
		float dy = ps.y;

		t1.xy = vec2(dx, 0.0);  /* F */
		t1.zw = vec2(0.0, dy);  /* H */
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	varying vec2 v_texture_coordinate;
	varying vec4 t1;
	varying float pix_sizex;
	varying float scan_sizey;

	/* RetroArch parameters */
	const float COLOR_BOOST = 1.25;  /* Color Boost 1.0 .. 2.0 */
	const float InputGamma = 2.4;    /* INPUT GAMMA 0.0 .. 4.0 */
	const float OutputGamma = 2.2;   /* OUTPUT GAMMA 0.0 .. 3.0 */

	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	vec3 gamma_in(vec3 color)
	{
		return pow(color, vec3(InputGamma, InputGamma, InputGamma));
	}

	vec3 gamma_out(vec3 color)
	{
		return pow(color, vec3(1.0 / OutputGamma, 1.0 / OutputGamma, 1.0 / OutputGamma));
	}

	float wgt(float size)
	{
		size = clamp(size, -1.0, 1.0);

		size = 1.0 - size * size;

		return size * size * size;
	}

	void main()
	{
		vec2 pos = fract(v_texture_coordinate * DS_SCREEN) - vec2(0.5, 0.5); /* pos = pixel position */
		vec2 dir = sign(pos); /* dir = pixel direction */
		pos      = abs(pos);

		vec2 g1 = dir * t1.xy;
		vec2 g2 = dir * t1.zw;

		vec3 A = gamma_in(texture2D(u_texture, v_texture_coordinate          ).xyz);
		vec3 B = gamma_in(texture2D(u_texture, v_texture_coordinate + g1     ).xyz);
		vec3 C = gamma_in(texture2D(u_texture, v_texture_coordinate      + g2).xyz);
		vec3 D = gamma_in(texture2D(u_texture, v_texture_coordinate + g1 + g2).xyz);

		vec2 dx = vec2(pos.x, 1.0 - pos.x) / pix_sizex;
		vec2 dy = vec2(pos.y, 1.0 - pos.y) / scan_sizey;

		vec2 wx = vec2(wgt(dx.x), wgt(dx.y));
		vec2 wy = vec2(wgt(dy.x), wgt(dy.y));

		vec3 color = (A * wx.x + B * wx.y) * wy.x + (C * wx.x + D * wx.y) * wy.y;

		color *= COLOR_BOOST;

		color = gamma_out(color);

		gl_FragColor = vec4(color, 1.0);
	}
</fragment>
