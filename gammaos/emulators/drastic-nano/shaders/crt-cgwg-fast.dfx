// crt-cgwg-fast: RetroArch crt/crt-cgwg-fast preset. cgwg / Themaister, GPL v2: Lanczos horizontal filter, Gaussian beam scanlines, green/magenta mask.
// Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch, scanline
// and mask phase in DS pixel space (256x192) so hi-res 3D (512x384 input) does not
// double the pattern; texel addressing keeps the real input texture size.
=============================================
<options>
name=crt-cgwg-fast
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=crt-cgwg-fast.dsd
sampler:u_texture=0
</pass>
