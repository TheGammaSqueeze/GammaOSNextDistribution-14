// fakelottes-geom: RetroArch crt/fakelottes-geom (hunterk's fakelottes with the
// smooth border and rounded corners of fake-crt-geom, by Rogalian aka cools): sine
// scanlines, crt-lottes curvature and phosphor mask in linear gamma, rounded corners.
// Ported for drastic-nano: one pass at the panel resolution, LINEAR fetch, the
// scanline in DS pixel space (256x192), the mask in output pixels as original.
=============================================
<options>
name=fakelottes-geom
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=fakelottes-geom.dsd
sampler:u_texture=0
</pass>
