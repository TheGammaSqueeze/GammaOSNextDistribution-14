<?xml version="1.0" encoding="UTF-8"?>
<!--
   crt-easymode shader (RetroArch crt/shaders/crt-easymode.glsl)
   CRT Shader by EasyMode
   License: GPL

   A flat CRT shader ideally for 1080p or higher displays.

   Recommended Settings:
   Video: Aspect Ratio 4:3, Integer Scale Off
   Shader: Filter Nearest, Scale Don't Care

   Example RGB Mask Parameter Settings:
   Aperture Grille (Default): Dot Width 1, Dot Height 1, Stagger 0
   Lottes' Shadow Mask: Dot Width 2, Dot Height 1, Stagger 3

   Build setting of the original kept: ENABLE_LANCZOS 1.
   drastic-nano port: the scanline cosine and the SCANLINE_CUTOFF height test use the
   DS screen (256x192) instead of the input texture size, so hi-res 3D does not
   double the scanlines; the texel-centre snap, the Lanczos tap offsets and the
   sub-texel distances keep the real input texture size. The mask stays keyed to
   output pixels.
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	uniform vec4 u_texture_size;
	uniform vec2 u_target_size;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters */
	const float SHARPNESS_H = 0.5;              /* Sharpness Horizontal 0.0 .. 1.0 */
	const float SHARPNESS_V = 1.0;              /* Sharpness Vertical 0.0 .. 1.0 */
	const float MASK_STRENGTH = 0.3;            /* Mask Strength 0.0 .. 1.0 */
	const float MASK_DOT_WIDTH = 1.0;           /* Mask Dot Width 1.0 .. 100.0 */
	const float MASK_DOT_HEIGHT = 1.0;          /* Mask Dot Height 1.0 .. 100.0 */
	const float MASK_STAGGER = 0.0;             /* Mask Stagger 0.0 .. 100.0 */
	const float MASK_SIZE = 1.0;                /* Mask Size 1.0 .. 100.0 */
	const float SCANLINE_STRENGTH = 1.0;        /* Scanline Strength 0.0 .. 1.0 */
	const float SCANLINE_BEAM_WIDTH_MIN = 1.5;  /* Scanline Beam Width Min. 0.5 .. 5.0 */
	const float SCANLINE_BEAM_WIDTH_MAX = 1.5;  /* Scanline Beam Width Max. 0.5 .. 5.0 */
	const float SCANLINE_BRIGHT_MIN = 0.35;     /* Scanline Brightness Min. 0.0 .. 1.0 */
	const float SCANLINE_BRIGHT_MAX = 0.65;     /* Scanline Brightness Max. 0.0 .. 1.0 */
	const float SCANLINE_CUTOFF = 400.0;        /* Scanline Cutoff 1.0 .. 1000.0 */
	const float GAMMA_INPUT = 2.0;              /* Gamma Input 0.1 .. 5.0 */
	const float GAMMA_OUTPUT = 1.8;             /* Gamma Output 0.1 .. 5.0 */
	const float BRIGHT_BOOST = 1.2;             /* Brightness Boost 1.0 .. 2.0 */
	const float DILATION = 1.0;                 /* Dilation 0.0 .. 1.0 */

	const float PI = 3.141592653589;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	vec4 fix4(vec4 c)
	{
		return max(abs(c), 1e-5);
	}

	vec4 dilate(vec4 col)
	{
		vec4 x = mix(vec4(1.0), col, DILATION);

		return col * x;
	}

	vec4 tex2d(vec2 c)
	{
		return dilate(texture2D(u_texture, c));
	}

	float curve_distance(float x, float sharp)
	{
		/* apply half-circle s-curve to distance for sharper (more pixelated) interpolation
		   single line formula for Graph Toy:
		   0.5 - sqrt(0.25 - (x - step(0.5, x)) * (x - step(0.5, x))) * sign(0.5 - x) */
		float x_step = step(0.5, x);
		float curve = 0.5 - sqrt(0.25 - (x - x_step) * (x - x_step)) * sign(0.5 - x);

		return mix(x, curve, sharp);
	}

	mat4 get_color_matrix(vec2 co, vec2 dx)
	{
		return mat4(tex2d(co - dx), tex2d(co), tex2d(co + dx), tex2d(co + 2.0 * dx));
	}

	vec3 filter_lanczos(vec4 coeffs, mat4 color_matrix)
	{
		vec4 col        = color_matrix * coeffs;
		vec4 sample_min = min(color_matrix[1], color_matrix[2]);
		vec4 sample_max = max(color_matrix[1], color_matrix[2]);

		col = clamp(col, sample_min, sample_max);

		return col.rgb;
	}

	void main()
	{
		/* texel addressing on the real input */
		vec2 dx     = vec2(u_texture_size.x, 0.0);
		vec2 dy     = vec2(0.0, u_texture_size.y);
		vec2 pix_co = v_texture_coordinate * u_texture_size.zw - vec2(0.5, 0.5);
		vec2 tex_co = (floor(pix_co) + vec2(0.5, 0.5)) * u_texture_size.xy;
		vec2 dist   = fract(pix_co);
		float curve_x;
		vec3 col, col2;

		curve_x = curve_distance(dist.x, SHARPNESS_H * SHARPNESS_H);

		vec4 coeffs = PI * vec4(1.0 + curve_x, curve_x, 1.0 - curve_x, 2.0 - curve_x);

		coeffs = fix4(coeffs);
		coeffs = 2.0 * sin(coeffs) * sin(coeffs * 0.5) / (coeffs * coeffs);
		coeffs /= dot(coeffs, vec4(1.0));

		col  = filter_lanczos(coeffs, get_color_matrix(tex_co, dx));
		col2 = filter_lanczos(coeffs, get_color_matrix(tex_co + dy, dx));

		col = mix(col, col2, curve_distance(dist.y, SHARPNESS_V));
		col = pow(col, vec3(GAMMA_INPUT / (DILATION + 1.0)));

		float luma        = dot(vec3(0.2126, 0.7152, 0.0722), col);
		float bright      = (max(col.r, max(col.g, col.b)) + luma) * 0.5;
		float scan_bright = clamp(bright, SCANLINE_BRIGHT_MIN, SCANLINE_BRIGHT_MAX);
		float scan_beam   = clamp(bright * SCANLINE_BEAM_WIDTH_MAX, SCANLINE_BEAM_WIDTH_MIN, SCANLINE_BEAM_WIDTH_MAX);
		/* source-pixel period: the scanline in DS pixel space */
		float scan_weight = 1.0 - pow(cos(v_texture_coordinate.y * 2.0 * PI * DS_SCREEN.y) * 0.5 + 0.5, scan_beam) * SCANLINE_STRENGTH;

		float mask   = 1.0 - MASK_STRENGTH;
		/* output-pixel mask */
		vec2 mod_fac = floor(v_texture_coordinate * u_target_size.xy / vec2(MASK_SIZE, MASK_DOT_HEIGHT * MASK_SIZE));
		int dot_no   = int(mod((mod_fac.x + mod(mod_fac.y, 2.0) * MASK_STAGGER) / MASK_DOT_WIDTH, 3.0));
		vec3 mask_weight;

		if      (dot_no == 0) mask_weight = vec3(1.0,  mask, mask);
		else if (dot_no == 1) mask_weight = vec3(mask, 1.0,  mask);
		else                  mask_weight = vec3(mask, mask, 1.0);

		if (DS_SCREEN.y >= SCANLINE_CUTOFF)
			scan_weight = 1.0;

		col2 = col.rgb;
		col *= vec3(scan_weight);
		col  = mix(col, col2, scan_bright);
		col *= mask_weight;
		col  = pow(col, vec3(1.0 / GAMMA_OUTPUT));

		gl_FragColor = vec4(col * BRIGHT_BOOST, 1.0);
	}
</fragment>
