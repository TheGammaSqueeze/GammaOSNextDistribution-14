// crt-lottes-fast: RetroArch crt/crt-lottes-fast (Timothy Lottes' CRTS public domain
// CRT-styled scaler, adapted by hunterk): 8-tap gaussian/cosine scanline filter in
// linear light, warp with vignette, phosphor mask keyed to output pixels, exposure
// matching tonemapper. Ported for drastic-nano: one pass at the panel resolution,
// LINEAR fetch, the whole CRTS filter in DS pixel space (256x192) as its input size.
=============================================
<options>
name=crt-lottes-fast
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=crt-lottes-fast.dsd
sampler:u_texture=0
</pass>
