// LCD3X: RetroArch handheld/lcd3x (Gigaherz, public domain): a sine scanline plus
// a three-phase red/green/blue subpixel grid (the LCD "colour separation").
// Ported for drastic-nano as the current RetroArch version: one pass at the
// panel resolution, NEAREST fetch, the grid in DS pixel space (256x192) so it is
// right under hi-res 3D (512x384 input) and Half Resolution alike. (The earlier
// port rendered a 3x intermediate and scaled it linearly, which blurred the grid
// and doubled its frequency under hi-res 3D.)
=============================================
<options>
name=LCD3X
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=lcd3x.dsd
sampler:u_texture=0
</pass>
