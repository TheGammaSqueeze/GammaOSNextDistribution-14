// 3xPrescaleFast shader
// Integer 3x prescale emulation in a single pass (nearest up-scale -> linear mapping)
//
// Files:
//   - prescale3x_fast.dsd
//
// Notes:
//   - Texture filter for the input is set to NEAREST; filtering is implemented in the shader.
//   - This avoids rendering an intermediate 3x framebuffer (significant fill-rate reduction).

<options>
name=3xPrescaleFast
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=prescale3x_fast.dsd
sampler:u_texture=0
</pass>
