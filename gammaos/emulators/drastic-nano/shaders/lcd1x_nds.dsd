<?xml version="1.0" encoding="UTF-8"?>
<!--
   lcd1x_nds shader (RetroArch handheld/shaders/lcd1x_nds.glsl)
   A slightly tweaked version of lcd3x:
   - Original lcd3x code written by Gigaherz and released into the public domain
   - Original 'nds_color' code written by hunterk, modified by Pokefan531 and
     released into the public domain
   > Omits LCD 'colour seperation' effect
   > Has 'properly' aligned scanlines
   > Includes NDS colour correction
   Edited by jdgleaver. GPL v2 or later.
   drastic-nano port: the grid is generated in DS pixel space (256x192), which is
   what the original does by dividing by the internal resolution scale factor.
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters (higher values mean a brighter image but a shallower effect) */
	const float BRIGHTEN_SCANLINES = 16.0;   /* 1.0 .. 32.0 */
	const float BRIGHTEN_LCD = 4.0;          /* 1.0 .. 12.0 */

	const float PI = 3.141592654;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	/* NDS colour correction (nds_color) */
	const float TARGET_GAMMA = 1.91;
	const float INV_DISPLAY_GAMMA = 1.0 / 1.91;
	const float CC_LUM = 0.89;
	const float CC_R  = 0.87;
	const float CC_G  = 0.645;
	const float CC_B  = 0.73;
	const float CC_RG = 0.10;
	const float CC_RB = 0.10;
	const float CC_GR = 0.255;
	const float CC_GB = 0.17;
	const float CC_BR = -0.125;
	const float CC_BG = 0.255;

	void main() {
		/* Note the 0.25 pixel offset: required so the scanlines fall BETWEEN pixels. */
		vec2 angle = 2.0 * PI * (v_texture_coordinate * DS_SCREEN - 0.25);
		float yfactor = (BRIGHTEN_SCANLINES + sin(angle.y)) / (BRIGHTEN_SCANLINES + 1.0);
		float xfactor = (BRIGHTEN_LCD + sin(angle.x)) / (BRIGHTEN_LCD + 1.0);
		vec3 colour = texture2D(u_texture, v_texture_coordinate).rgb;
		/* Colour correction, the original's expression verbatim (same mat3 constructor,
		   same column-major GLSL semantics, same product). */
		colour = pow(colour, vec3(TARGET_GAMMA));
		colour = mat3(CC_R,  CC_RG, CC_RB,
		              CC_GR, CC_G,  CC_GB,
		              CC_BR, CC_BG, CC_B) * (colour * CC_LUM);
		colour = clamp(pow(colour, vec3(INV_DISPLAY_GAMMA)), 0.0, 1.0);
		gl_FragColor = vec4(yfactor * xfactor * colour, 1.0);
	}
</fragment>
