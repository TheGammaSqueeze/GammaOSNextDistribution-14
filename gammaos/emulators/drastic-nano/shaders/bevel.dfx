// bevel: RetroArch handheld/bevel (Hyllian, GPL v2): every source pixel gets a
// bevelled highlight that falls off from its top-left corner, gamma-correct.
// Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch, the
// pixel cells in DS pixel space (256x192) so hi-res 3D does not double them.
=============================================
<options>
name=bevel
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=bevel.dsd
sampler:u_texture=0
</pass>
