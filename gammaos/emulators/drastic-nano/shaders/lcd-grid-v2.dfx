// lcd-grid-v2: RetroArch handheld/lcd-grid-v2 (cgwg): analytically integrated RGB
// subpixel triads with separate horizontal/vertical smear kernels, configurable
// subpixel colours, gain, black level and ambient light, with the preset's
// parameter values (0.75 subpixel colours, gain 1.5, gamma 2.2, black level 0).
// Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch, the
// cell grid in DS pixel space (256x192) so hi-res 3D does not double it.
=============================================
<options>
name=lcd-grid-v2
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=lcd-grid-v2.dsd
sampler:u_texture=0
</pass>
