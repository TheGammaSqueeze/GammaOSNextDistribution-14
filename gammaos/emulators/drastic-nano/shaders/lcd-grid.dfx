// lcd-grid: RetroArch handheld/lcd-grid (cgwg's LCD grid shader): area-averaged
// RGB subpixel triads with a dark horizontal grid line, gamma-correct blending.
// Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch, the
// cell/subpixel grid in DS pixel space (256x192) so hi-res 3D does not double it.
=============================================
<options>
name=lcd-grid
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=lcd-grid.dsd
sampler:u_texture=0
</pass>
