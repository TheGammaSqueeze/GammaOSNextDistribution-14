<?xml version="1.0" encoding="UTF-8"?>
<!--
   cgwg's CRT shader (RetroArch crt/shaders/crt-cgwg-fast.glsl)
   Copyright (C) 2010-2011 cgwg, Themaister
   GPL v2 or later.
   (cgwg gave their consent to have their code distributed under the GPL in this message:
   http://board.byuu.org/viewtopic.php?p=26075#p26075
   "Feel free to distribute my shaders under the GPL. After all, the barrel distortion
   code was taken from the Curvature shader, which is under the GPL.")
   drastic-nano port: the vertical beam position (uv_ratio.y) is computed in DS pixel
   space (256x192) so hi-res 3D does not double the scanlines; the 4x2 tap offsets and
   the horizontal Lanczos phase (uv_ratio.x) keep the real texel size. The per-vertex
   tap coordinates are computed per fragment (same linear expressions). The mask
   (mod_factor) stays on output pixels; TextureSize/InputSize ratio is 1 on the DS.
-->
<options>
filter=nearest
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	uniform vec4 u_texture_size;
	uniform vec2 u_target_size;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters */
	const float CRTCGWG_GAMMA = 2.7;   /* CRTcgwg Gamma         0.0 .. 10.0 */
	const float CGWG = 0.7;            /* CGWG Mask Brightness  0.0 .. 1.0  */

	const float PI = 3.141592653589;
	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	vec4 TEX2D(vec2 c) {
		return texture2D(u_texture, c);
	}

	void main() {
		vec2 tc = v_texture_coordinate;
		float dx = u_texture_size.x;
		float dy = u_texture_size.y;

		vec2 c01 = tc + vec2(-dx, 0.0);
		vec2 c11 = tc + vec2(0.0, 0.0);
		vec2 c21 = tc + vec2(dx, 0.0);
		vec2 c31 = tc + vec2(2.0 * dx, 0.0);
		vec2 c02 = tc + vec2(-dx, dy);
		vec2 c12 = tc + vec2(0.0, dy);
		vec2 c22 = tc + vec2(dx, dy);
		vec2 c32 = tc + vec2(2.0 * dx, dy);
		float mod_factor = tc.x * u_target_size.x;

		/* horizontal phase in texel space, vertical beam phase in DS pixel space */
		vec2 uv_ratio = vec2(fract(tc.x * u_texture_size.z), fract(tc.y * DS_SCREEN.y));
		vec3 col, col2;

		mat4 texes0 = mat4(TEX2D(c01).xyzw, TEX2D(c11).xyzw, TEX2D(c21).xyzw, TEX2D(c31).xyzw);
		mat4 texes1 = mat4(TEX2D(c02).xyzw, TEX2D(c12).xyzw, TEX2D(c22).xyzw, TEX2D(c32).xyzw);

		vec4 coeffs = vec4(1.0 + uv_ratio.x, uv_ratio.x, 1.0 - uv_ratio.x, 2.0 - uv_ratio.x) + 0.005;
		coeffs = sin(PI * coeffs) * sin(0.5 * PI * coeffs) / (coeffs * coeffs);
		coeffs = coeffs / dot(coeffs, vec4(1.0, 1.0, 1.0, 1.0));

		vec3 weights  = vec3( 3.33 * uv_ratio.y,        uv_ratio.y *  3.33,        uv_ratio.y *  3.33);
		vec3 weights2 = vec3(-3.33 * uv_ratio.y + 3.33, uv_ratio.y * -3.33 + 3.33, uv_ratio.y * -3.33 + 3.33);

		col  = clamp(texes0 * coeffs, 0.0, 1.0).xyz;
		col2 = clamp(texes1 * coeffs, 0.0, 1.0).xyz;

		vec3 wid  = 2.0 * pow(col,  vec3(4.0)) + 2.0;
		vec3 wid2 = 2.0 * pow(col2, vec3(4.0)) + 2.0;

		col  = pow(col,  vec3(CRTCGWG_GAMMA));
		col2 = pow(col2, vec3(CRTCGWG_GAMMA));

		vec3 sqrt1 = inversesqrt(0.5 * wid);
		vec3 sqrt2 = inversesqrt(0.5 * wid2);

		vec3 pow_mul1 = weights * sqrt1;
		vec3 pow_mul2 = weights2 * sqrt2;

		vec3 div1 = 0.1320 * wid  + 0.392;
		vec3 div2 = 0.1320 * wid2 + 0.392;

		vec3 pow1 = -pow(pow_mul1, wid);
		vec3 pow2 = -pow(pow_mul2, wid2);

		weights  = exp(pow1) / div1;
		weights2 = exp(pow2) / div2;

		vec3 multi = col * weights + col2 * weights2;
		vec3 mcol  = mix(vec3(1.0, CGWG, 1.0), vec3(CGWG, 1.0, CGWG), floor(mod(mod_factor, 2.0)));

		gl_FragColor = vec4(pow(mcol * multi, vec3(0.454545, 0.454545, 0.454545)), 1.0);
	}
</fragment>
