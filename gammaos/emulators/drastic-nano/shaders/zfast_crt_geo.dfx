// zfast_crt_geo: RetroArch crt/zfast_crt_geo preset. Greg Hogan / Dogway, GPL v2: zfast with curvature, vignette, rounded corners, P22 D93 phosphor, linear-light scanline and mask.
// Ported for drastic-nano: one pass at the panel resolution, LINEAR fetch, scanline
// and mask phase in DS pixel space (256x192) so hi-res 3D (512x384 input) does not
// double the pattern; texel addressing keeps the real input texture size.
=============================================
<options>
name=zfast_crt_geo
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_LINEAR
mag_filter=GL_LINEAR
</texture>

<pass>
shader=zfast_crt_geo.dsd
sampler:u_texture=0
</pass>
