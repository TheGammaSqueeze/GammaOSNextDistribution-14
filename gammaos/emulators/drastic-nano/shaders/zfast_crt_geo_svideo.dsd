<?xml version="1.0" encoding="UTF-8"?>
<!--
   zfast_crt_geo_svideo - A simple, fast CRT shader. (RetroArch crt/shaders/zfast_crt_geo_svideo.glsl)
   Copyright (C) 2017 Greg Hogan (SoltanGris42)
   Copyright (C) 2023 Jose Linares (Dogway)
   GPL v2 or later.
   Notes: brightness dependent scanline and monochrome aperture mask in linear light.
   Dogway: same as zfast_crt_geo but with extra blurring based on zfast_crt_composite
   and some desaturation for an S-Video effect.
   drastic-nano port: the scanline phase is computed in DS pixel space (256x192) so
   hi-res 3D does not double the scanlines; the convergence blur offsets keep the real
   texel size. TextureSize/InputSize ratio ("scale") is 1 on the DS.
-->
<options>
filter=linear
</options>

<vertex>
	attribute vec2 a_vertex_coordinate;
	attribute vec2 a_texture_coordinate;
	varying vec2 v_texture_coordinate;

	void main() {
		gl_Position = vec4(a_vertex_coordinate.xy, 0.0, 1.0);
		v_texture_coordinate = a_texture_coordinate;
	}
</vertex>

<fragment>
	uniform sampler2D u_texture;
	uniform vec4 u_texture_size;
	uniform vec2 u_target_size;
	varying vec2 v_texture_coordinate;

	/* RetroArch parameters */
	const float SCANLINE_WEIGHT = 9.0;   /* Scanline Amount     0.0 .. 15.0 */
	const float MASK_DARK = 0.4;         /* Mask Effect Amount  0.0 .. 1.0  */
	const float blurx = 0.70;            /* Convergence X-Axis -2.0 .. 2.0  */
	const float blury = -0.30;           /* Convergence Y-Axis -2.0 .. 2.0  */

	const vec2 DS_SCREEN = vec2(256.0, 192.0);

	/* This compensates the scanline+mask embedded gamma from the beam dynamics */
	const vec3 pwr = vec3(1.0 / ((-0.0325 * SCANLINE_WEIGHT + 1.0) * (-0.311 * MASK_DARK + 1.0)) - 1.2);

	/* P22D93 * SAT95 (NTSC-J D93 -> Rec709 D65 joint matrix times a 0.95 saturation matrix) */
	const mat3 P22D93SAT95 = mat3(
	     0.920603871345520000, 0.06930985301733017, -0.051645118743181230,
	     0.087028317153453830, 0.94945263862609860, -0.007860664278268814,
	     0.013233962468802929, 0.11829412728548050,  1.023241996765136700);

	/* Returns gamma corrected output, compensated for scanline+mask embedded gamma */
	vec3 inv_gamma(vec3 col, vec3 power) {
		vec3 cir = col - 1.0;
		cir *= cir;
		col = mix(sqrt(col), sqrt(1.0 - cir), power);
		return col;
	}

	vec2 Warp(vec2 pos) {
		pos = pos * 2.0 - 1.0;
		pos *= vec2(1.0 + (pos.y * pos.y) * 0.0276, 1.0 + (pos.x * pos.x) * 0.0414);
		return pos * 0.5 + 0.5;
	}

	void main() {
		float MSCL = (u_target_size.y > 1499.0) ? 0.3333 : 0.5;
		vec2 blur_xy = vec2(blurx, blury) * u_texture_size.xy * 0.5;

		vec2 vpos = v_texture_coordinate;
		vec2 xy = Warp(vpos);

		vec2 corn = min(xy, 1.0 - xy);   /* This is used to mask the rounded */
		corn.x = 0.0001 / corn.x;        /* corners later on */

		vec2 sample1 = texture2D(u_texture, vec2(xy.x + blur_xy.x, xy.y - blur_xy.y)).rg;
		vec3 sample2 = texture2D(u_texture, xy).rgb;
		vec2 sample3 = texture2D(u_texture, vec2(xy.x - blur_xy.x, xy.y + blur_xy.y)).gb;

		vec3 colour = vec3(sample1.r * 0.50, sample1.g * 0.25 + sample3.r * 0.25, sample3.g * 0.50) + 0.5 * sample2;

		vpos *= (1.0 - vpos.xy);
		float vig = vpos.x * vpos.y * 46.0;
		vig = min(sqrt(vig), 1.0);

		/* Scanline phase in DS pixel space */
		float ratio_scale = v_texture_coordinate.y * DS_SCREEN.y;
		float f = ratio_scale - (floor(ratio_scale) + 0.5);
		float Y = f * f;

		float whichmask = floor(v_texture_coordinate.x * u_target_size.x) * -MSCL;
		float mask = 1.0 + float(fract(whichmask) < MSCL) * -MASK_DARK;

		colour = max((colour * colour) * (P22D93SAT95 * vig), 0.0);

		float scanLineWeight = (1.5 - SCANLINE_WEIGHT * (Y - Y * Y));

		if (corn.y <= corn.x || corn.x < 0.0001)
			colour = vec3(0.0);

		gl_FragColor = vec4(inv_gamma(colour.rgb * mix(scanLineWeight * mask, 1.0, colour.r * 0.26667 + colour.g * 0.26667 + colour.b * 0.26667), pwr), 1.0);
	}
</fragment>
