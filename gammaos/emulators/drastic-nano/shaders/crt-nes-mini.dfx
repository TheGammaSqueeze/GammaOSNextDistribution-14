// crt-nes-mini: RetroArch crt/crt-nes-mini: the NES Classic Mini style CRT filter,
// alternating bright/dark scanlines with a luminance boost on the bright rows.
// Ported for drastic-nano: one pass at the panel resolution, NEAREST fetch, the
// scanline parity in DS pixel space (256x192) so hi-res 3D does not double it.
=============================================
<options>
name=crt-nes-mini
textures=1
</options>

<fheader>
#if GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif
</fheader>

<texture:0>
input=framebuffer
min_filter=GL_NEAREST
mag_filter=GL_NEAREST
</texture>

<pass>
shader=crt-nes-mini.dsd
sampler:u_texture=0
</pass>
