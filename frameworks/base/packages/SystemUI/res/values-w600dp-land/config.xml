<!-- GammaOS: values-land was retargeted to a narrow/square default (2 QS columns, full-width
     notifications) so small square panels like the 720x720 RG Rotate (~480dp available width) are
     not cramped. This bucket restores the stock wide-landscape layout for genuinely wide panels
     (>=600dp available width: phones and wide handhelds in landscape). Available-width (w) outranks
     the bare -land qualifier, so wide panels pick these up while the 480dp square panel does not
     (it stays on values-land). Tablets are unaffected: smallestWidth (sw600dp-land/sw720dp-land)
     outranks available-width, so their 2-/3-column tablet layout still wins. -->
<resources>
    <integer name="quick_settings_num_columns">4</integer>
    <bool name="config_skinnyNotifsInLandscape">true</bool>
</resources>
