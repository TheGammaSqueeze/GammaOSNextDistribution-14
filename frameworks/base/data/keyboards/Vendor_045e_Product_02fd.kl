#
# GammaOS Virtual Gamepad — identity for Xbox Wireless Controller (045e:02fd)
#
# The gammapad daemon handles physical-to-logical mapping internally.
# This .kl maps the standard evdev codes the virtual device emits.
# Buttons NOT listed here pass through with scancode as keycode
# (see KeyboardInputMapper gamepad passthrough).
#

# Standard gamepad buttons
key 304   BUTTON_A
key 305   BUTTON_B
key 306   BUTTON_C
key 307   BUTTON_X
key 308   BUTTON_Y
key 309   BUTTON_Z
key 310   BUTTON_L1
key 311   BUTTON_R1
key 312   BUTTON_L2
key 313   BUTTON_R2
key 314   BUTTON_SELECT
key 315   BUTTON_START
key 316   BUTTON_MODE
key 317   BUTTON_THUMBL
key 318   BUTTON_THUMBR

# DPAD buttons
key 544   DPAD_UP
key 545   DPAD_DOWN
key 546   DPAD_LEFT
key 547   DPAD_RIGHT

# Common keys (for remap targets)
key 1     ESCAPE
key 14    DEL
key 28    ENTER
key 57    SPACE
key 102   HOME
key 113   VOLUME_MUTE
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 116   POWER
key 139   MENU
key 158   BACK
key 204   ALL_APPS
key 217   SEARCH

# Axes — standard gamepad layout
axis 0x00 X flat 4096
axis 0x01 Y flat 4096
axis 0x02 Z flat 4096
axis 0x03 RX flat 4096
axis 0x04 RY flat 4096
axis 0x05 RZ flat 4096
axis 0x09 RTRIGGER
axis 0x0a LTRIGGER

# Hat / DPAD axes
axis 0x10 HAT_X
axis 0x11 HAT_Y
