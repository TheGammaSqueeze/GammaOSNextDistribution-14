service azahar-nano /system/bin/azahar-nano
    class main
    user root
    group root graphics input system media_rw sdcard_rw everybody external_storage package_info audio readproc inet net_bw_stats
    capabilities SYS_NICE IPC_LOCK SYS_RESOURCE DAC_READ_SEARCH DAC_OVERRIDE CHOWN SYS_ADMIN
    disabled
    oneshot
    ioprio rt 0
    rlimit rtprio 99 99
    rlimit memlock 536870912 536870912
    task_profiles MaxPerformance
    oom_score_adjust 0

# Start trigger: gammaos-nano writes the ROM path to
# /data/system/nano_azahar_nano_rom.txt, then sets this property to 1.
on property:sys.gammaos.azahar_nano.start=1
    setprop sys.gammaos.azahar_nano.start 0
    setprop sys.gammaos.azahar_nano.session_done 0
    setprop sys.gammaos.azahar_nano.session 1
    stop gammaos-nano
    stop gammaos-nano-overlay
    start azahar-nano

# Debug start without touching the home (SurfaceFlinger backend only).
on property:sys.gammaos.azahar_nano.start_sf=1
    setprop sys.gammaos.azahar_nano.start_sf 0
    setprop sys.gammaos.azahar_nano.session_done 0
    setprop sys.gammaos.azahar_nano.session 1
    start azahar-nano

# The service died without reporting (init's stop sends SIGKILL, a crash the handler
# could not catch, an OOM kill): release SurfaceFlinger and bring the home back the
# same way a normal exit does. A normal exit already cleared session below.
on property:init.svc.azahar-nano=stopped && property:sys.gammaos.azahar_nano.session=1
    setprop sys.gammaos.azahar_nano.session 0
    setprop sys.gammaos.nano.drm_active 0
    setprop sys.gammaos.azahar_nano.session_done 1

on property:sys.gammaos.azahar_nano.session_done=1 && property:persist.gammaos.nano.drm_home_resume=1
    setprop sys.gammaos.nano.force_drm 1

on property:sys.gammaos.azahar_nano.session_done=1
    setprop sys.gammaos.azahar_nano.session_done 0
    setprop sys.gammaos.azahar_nano.session 0
    setprop service.bootanim.exit 0
    start gammaos-nano
