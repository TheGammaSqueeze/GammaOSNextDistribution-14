// azahar-nano: the GammaOS Nano frontend for the Azahar 3DS core.
//
// The core (libazahar-nano-core.so, built out of tree from the Azahar source with
// the NDK, see /home/gamma/azahar-nano) is dlopened through its C ABI
// (AzaharNanoApi.h). This binary owns the panels (SurfaceFlinger or DRM), input,
// the overlay and the session lifecycle, mirroring drastic-nano.

cc_binary {
    name: "azahar-nano",

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-O2",
    ],

    srcs: [
        "main.cpp",
        "SfWindows.cpp",
        "DrmWindows.cpp",
        "NanoInput.cpp",
        "Overlay.cpp",
        "Hud.cpp",
        "GpuDriverPkg.cpp",
        "Brightness.cpp",
        "AzaharSettings.cpp",
        "CheatDb.cpp",
        ":drastic_nano_overlay_gfx_srcs",
        ":drastic_nano_osk_srcs",
        ":nano_i18n_srcs",
    ],
    include_dirs: [
        "frameworks/base/cmds/gammaos-nano",
    ],

    header_libs: [
        "libdrm_headers",
        "drastic_nano_overlay_headers",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libnativewindow",
        "libdrm",
        "libEGL",
        "libGLESv2",
        "libft2",
        "libziparchive",
        "libbinder_ndk",
        "libhidlbase",
        "android.hardware.light-V2-ndk",
        "android.hardware.light@2.0",
    ],

    init_rc: ["azahar-nano.rc"],
}

// The 3DS cheat database (CTRPF, 60FPS and Sharkive Action Replay codes), built by
// tools/make_cheat_db.py; merged with the user's own cheat files when a game starts.
prebuilt_etc {
    name: "azahar-nano-cheats",
    src: "assets/cheats3ds.zip",
    filename: "cheats3ds.zip",
    sub_dir: "azahar-nano",
}
