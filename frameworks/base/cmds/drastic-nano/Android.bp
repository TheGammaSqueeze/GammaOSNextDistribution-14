package {
    default_applicable_licenses: ["drastic_nano_license"],
}

// Explicit licensing for drastic-nano: the GammaOS frontend code is Apache-2.0
// (LICENSE, NOTICE), and the RetroAchievements integration links rcheevos under
// the MIT License (LICENSE.rcheevos, also reproduced in NOTICE).
license {
    name: "drastic_nano_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
        "LICENSE.rcheevos",
        "NOTICE",
    ],
}

cc_binary {
    name: "drastic-nano",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        // Match the rcheevos build config so rc_client.h exposes the same API
        // (the hash-based load) and the same lua_State typedef as librcheevos_nano.
        "-DRC_DISABLE_LUA",
        "-DRC_CLIENT_SUPPORTS_HASH",
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-unused-private-field",
        "-Wno-deprecated-declarations",
        "-O3",
        "-ffast-math",
        "-fno-math-errno",
        "-fno-trapping-math",
    ],

    arch: {
        arm64: {
            cflags: [
                "-mtune=cortex-a55",
            ],
        },
    },

    local_include_dirs: ["."],
    include_dirs: [
        "frameworks/base/cmds/gammaos-nano",
    ],

    srcs: [
        "main.cpp",
        "DrasticPrefs.cpp",
        "InputMap.cpp",
        "OverlayGfx.cpp",
        "OverlayMenu.cpp",
        "OverlayMenuRa.cpp",
        "DrasticOsk.cpp",
        "NanoRetroAchievements.cpp",
        "DsScreenLayout.cpp",
        "SfDisplayBackend.cpp",
        ":drastic_nano_shared_srcs",
    ],

    header_libs: [
        "libdrm_headers",
        "jni_headers",
    ],

    // RetroAchievements: the vendored rcheevos rc_client library. Its
    // export_include_dirs makes <rc_client.h> etc. visible to
    // NanoRetroAchievements.cpp, and it pulls libz for the rhash ROM hashers.
    static_libs: [
        "librcheevos_nano",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv2",
        "libnativewindow",
        "libft2",
        "libz",
        "libaaudio",
        "android.hardware.health-V2-ndk",
        "android.hardware.light-V2-ndk",
    ],

    init_rc: ["drastic-nano.rc"],
}
