service drastic-nano /system/bin/drastic-nano
    class main
    user root
    group root graphics input system media_rw sdcard_rw everybody external_storage package_info audio readproc inet net_bw_stats
    capabilities SYS_NICE IPC_LOCK SYS_RESOURCE DAC_READ_SEARCH DAC_OVERRIDE CHOWN
    # `inet` (AID_INET 3003) is REQUIRED for network: the rc restricts capabilities
    # (no CAP_NET_RAW), so Android's paranoid-network gate (in_egroup_p(AID_INET) ||
    # capable(CAP_NET_RAW)) would otherwise EACCES every socket -- which broke the
    # RetroAchievements login (the forked curl could not open a socket). net_bw_stats
    # (3006) lets its sockets be tagged for per-uid stats like every other net client.
    disabled
    oneshot
    ioprio rt 0
    rlimit rtprio 99 99
    rlimit memlock 536870912 536870912
    task_profiles MaxPerformance
    # Safety net: keep drastic-nano KILLABLE (foreground-app bucket) rather than
    # inheriting init's -1000 (unkillable). If a huge ROM ever exhausts RAM, the
    # low-memory killer must take the game (recoverable: the home restarts), NOT
    # system_server -- which at -1000 was the observed failure (DeadSystemException
    # -> whole-device freeze needing a power-cycle). system_server sits at -900, so
    # 0 makes drastic-nano the last-resort victim above it while never touching it.
    oom_score_adjust 0

# drastic-nano start trigger. gammaos-nano writes the ROM path to
# /data/system/nano_drastic_nano_rom.txt, then sets this property to 1.
# We intentionally do NOT stop SurfaceFlinger: system_server's
# Watchdog kills the whole system after ~60-80 s without SF
# reachable on the AIDL binder. Instead, drastic-nano just grabs DRM
# master via drmEarlySplash -- SF stays alive and answers binder
# calls, it just cannot present to the panel because master is ours.
# Mirrors gammaos-nano's QR preview pattern.
on property:sys.gammaos.drastic_nano.start=1
    setprop sys.gammaos.drastic_nano.start 0
    setprop sys.gammaos.drastic_nano.session_done 0
    # Stop gammaos-nano explicitly. In the production XMB flow the
    # nano process calls _exit(0) before firing start=1, so this is
    # usually a no-op -- but if drastic_nano.start=1 fires through
    # any other path (debug setprop, an external trigger) nano would
    # otherwise keep running and compete with drastic-nano for DRM
    # master, input fds, and CPU -- visible as frame spikes / slow
    # drmDrainPageFlipEvents (user-confirmed 2026-04-17). Belt-and-
    # braces.
    #
    # Also stop the resident overlay (gammaos-nano --overlay). In overlay-home
    # mode the overlay is the launcher and owns SurfaceFlinger's panel takeover;
    # a DS ROM launched from it routes here (NanoMenu::overlayLaunchGame), so the
    # overlay must release the panel before drastic-nano grabs DRM master. A
    # no-op when the overlay is not running (the normal home launch).
    stop gammaos-nano
    stop gammaos-nano-overlay
    start drastic-nano

# drastic-nano start trigger for SurfaceFlinger mode (backend=sf). This ONLY
# starts the binary -- it must NOT stop the home (gammaos-nano) or the overlay.
# In SF mode the DrasticSf host activity is launched as a normal app (launch_app),
# so the home performs its OWN clean DRM -> SurfaceFlinger handoff exactly like an
# Aurora Store launch: the framework sets service.bootanim.exit=1 once the activity
# window draws (WindowManagerService, gated on nano_retroarch=1) and the home
# self-exits there, dropping DRM master so SurfaceFlinger can present to the panel,
# and the overlay comes up as the SF panel-takeover keeper. A `stop gammaos-nano`
# here KILLS the home at ~114ms BEFORE that clean handoff runs, leaving the panel
# not presenting through SF -- a black screen for BOTH drastic and the overlay
# menu. drastic-nano reads backend=sf and goes host-surface (never touches DRM
# master), so starting it early is harmless: it just waits for the activity's
# Surface while the home hands off.
on property:sys.gammaos.drastic_nano.start_sf=1
    setprop sys.gammaos.drastic_nano.start_sf 0
    setprop sys.gammaos.drastic_nano.session_done 0
    start drastic-nano

# drastic-nano exit trigger. drastic-nano sets session_done=1 on
# clean shutdown or from the signal handler on crash. Nano restart
# brings the user back to the XMB.
on property:sys.gammaos.drastic_nano.session_done=1
    setprop sys.gammaos.drastic_nano.session_done 0
    # Clear the real-session shader signal so the home's QR preview, which
    # shares DrasticRunner, stays on the renderFrame path after the session.
    setprop sys.gammaos.drastic_nano.session 0
    # Clear the one-shot Quick Resume marker here (not only in drastic-nano's clean
    # exit tail): session_done fires on clean exit, crash (crashCleanup) and init
    # failure alike, so a crashed resume session cannot leak qr_resume=1 into a
    # later same-boot direct DS launch (which would force a slot-9 load and drop RA
    # hardcore for the wrong game). Fires AFTER the in-session RA client read.
    setprop sys.gammaos.drastic_nano.qr_resume 0
    setprop service.bootanim.exit 0
    setprop service.bootanim.nano_retroarch 0
    start gammaos-nano
