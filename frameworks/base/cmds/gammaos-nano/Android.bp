package {
    default_applicable_licenses: ["frameworks_base_license"],
}

cc_binary {
    name: "gammaos-nano",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
        "-Wno-deprecated-declarations",
    ],

    srcs: [
        "main.cpp",
        "NanoMenu.cpp",
        "LibretroRunner.cpp",
    ],

    header_libs: [
        "libdrm_headers",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv2",
        "libft2",
        "libpng",
        "libz",
        "android.hardware.light-V2-ndk",
        "android.hardware.light@2.0",
        "libhidlbase",
        "libnativewindow",
    ],

    init_rc: ["gammaos-nano.rc"],
}
