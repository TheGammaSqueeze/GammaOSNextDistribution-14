package {
    default_applicable_licenses: ["frameworks_base_license"],
}

cc_binary {
    name: "gammaos-nano",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
        "-Wno-deprecated-declarations",
        // GammaOS: aggressive optimization for Nano render hot path.
        // NanoMenu has no IEEE float correctness requirements and the blit
        // loops benefit from vectorization/unrolling.
        "-O3",
        "-ffast-math",
        "-fno-math-errno",
        "-fno-trapping-math",
    ],

    arch: {
        arm64: {
            cflags: [
                // Tune pipeline scheduling for Cortex-A55 (RG DS / RK3568 and
                // most handheld targets). This does NOT change the target
                // architecture baseline (still ARMv8-A); it only hints at
                // A55's in-order 2-wide issue to help instruction scheduling.
                // The binary remains compatible with any ARMv8-A device.
                "-mtune=cortex-a55",
            ],
        },
    },

    // ThinLTO: cross-translation-unit inlining and dead-code stripping across the
    // ~40 nano source files. Shrinks .text (clean/file-backed, but still image
    // weight and faulted-in pages) and tightens the render hot path. No behaviour
    // change; -ffast-math semantics are unchanged under LTO.
    lto: {
        thin: true,
    },

    srcs: [
        "main.cpp",
        "NanoMenu.cpp",
        "NanoMenuDrm.cpp",
        "NanoMenuRgbFollow.cpp",
        "NanoMenuXmb.cpp",
        "NanoMenuShaders.cpp",
        "NanoMenuEffects.cpp",
        "NanoMenuInput.cpp",
        "NanoMenuState.cpp",
        "NanoMenuSystem.cpp",
        "NanoMenuNet.cpp",
        "NanoMenuSettings.cpp",
        "NanoMenuSettingsTree.cpp",
        "NanoMenuSettingsRender.cpp",
        "NanoMenuRender.cpp",
        "NanoMenuOverlay.cpp",
        "NanoMenuPS3Layout.cpp",
        "NanoMenuPS3Bg.cpp",
        "NanoMenuPS3Particles.cpp",
        "NanoMenuPS3Icons.cpp",
        "NanoMenuPS3IconGrid.cpp",
        "NanoMenuPS3EmuCatalog.cpp",
        "NanoMenuPS3Folder.cpp",
        "NanoMenuFileExplorer.cpp",
        "NanoMenuPS3Menu.cpp",
        "NanoMenuPS3Clock.cpp",
        "NanoControlCenter.cpp",
        "NanoMenuPS3Globe.cpp",
        "NanoMenuPS3Boot.cpp",
        "NanoBootChime.cpp",
        "NanoHalChime.cpp",
        "NanoOtaCheck.cpp",
        "NanoMenuOta.cpp",
        "NanoMenuSetupWizard.cpp",
        "NanoMenuStrings.cpp",
        "NanoBtStable.cpp",
        "NanoAudio.cpp",
        "NanoMenuAudioBands.cpp",
        "NanoMenuMusic.cpp",
        "NanoMenuMedia.cpp",
        "NanoMenuMusicCanyon.cpp",
        "NanoMenuMusicGlobe.cpp",
        "NanoMenuPhotos.cpp",
        "NanoVideo.cpp",
        "NanoDvbSub.cpp",
        "NanoTsDescramble.cpp",
        "NanoTsDemux.cpp",
        "NanoAviDemux.cpp",
        "NanoMenuVideo.cpp",
        "NanoMenuIptv.cpp",
        "NanoMenuRadio.cpp",
        "NanoHls.cpp",
        "NanoIcyDemux.cpp",
        "NanoMenuSearch.cpp",
        "NanoAc3.cpp",
        "NanoAacDec.cpp",
        "NanoCea608.cpp",
        "NanoScraper.cpp",
        "NanoMenuScraper.cpp",
        "NanoJson.cpp",
        "NanoI18n.cpp",
        "NanoOsk.cpp",
        "LibretroRunner.cpp",
        "FakeJNI.cpp",
        "DrasticRunner.cpp",
    ],

    // Vendored liba52 public header (a52.h) for NanoAc3.cpp.
    local_include_dirs: ["liba52/include"],

    static_libs: [
        "liba52_nano",   // AC-3 decoder (no AC-3 codec on the device)
    ],

    header_libs: [
        "libdrm_headers",
        "jni_headers",
        "native_headers",   // <android/imagedecoder.h> + <android/bitmap.h> (photo viewer decode)
        "libgammargb_process_headers",   // shared GammaRGB colour pipeline (parity with SF sampler)
        "libaudiohal_headers",   // media/audiohal/* (NanoHalChime: drive the vendor audio HAL directly)
        "liberror_headers",      // error/Result.h pulled by the libaudiohal headers
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv2",
        "libft2",
        "libpng",
        "libz",
        "android.hardware.health-V2-ndk",
        "android.hardware.health@2.0",
        "android.hardware.light-V2-ndk",
        "android.hardware.light@2.0",
        "libhidlbase",
        "libnativewindow",
        "libandroid",   // APerformanceHint (ADPF render-thread hint session)
        "libaaudio",    // GammaEQ audio preview + music player output (AAudio)
        "libmediandk",  // music player decode: AMediaExtractor + AMediaCodec -> PCM
        "libtinyalsa",  // RG DS boot chime: direct ALSA PCM write, bypasses AudioFlinger (NanoBootChime)
        "libaudiohal",  // SPRD boot chime: drive the vendor audio HAL directly, bypass audioserver's ~11.7s AudioPolicyManager (NanoHalChime)
        "libaudiofoundation",
        "libjnigraphics",  // photo viewer: AImageDecoder scaled-on-decode (JPEG/PNG/...)
    ],

    init_rc: ["gammaos-nano.rc"],
    required: [
        "nano-ce-unlock.sh",
        "joypad_uevent_fixup.sh",
        "nano_xmb_fonts",
        "nano_xmb_wave",
        "nano_xmb_gradients",
        "nano_xmb_boot",
        "nano_xmb_icons",
        "nano_xmb_normalmaps",
        "nano_xmb_glass",
        "nano_xmb_textures",
        "nano_xmb_globe",
        "nano_xmb_icons_retroarch",
        "nano_xmb_icons_ui",
        "nano_xmb_nds",
        "nano_xmb_daijishou",
        "nano_xmb_i18n",
        "nano_xmb_audio",
        "nano_xmb_audioplayer",
        "nano_xmb_videoplayer",
        "nano_xmb_canyon",
        "nano_xmb_photoviewer",
        "nano_xmb_backgrounds",
    ],
}

// Vendored liba52 (a52dec 0.7.4, GPL-2) - AC-3 decoder. The device has no hardware
// or software AC-3 codec, so NanoAc3 uses this to decode AC-3 audio in .ts / MKV / VOB.
// Pure-C generic path (no SIMD / djbfft / memalign); -w because the 2002-era source
// is not -Werror clean. config.h lives in liba52/include.
cc_library_static {
    name: "liba52_nano",
    srcs: [
        "liba52/liba52/bit_allocate.c",
        "liba52/liba52/bitstream.c",
        "liba52/liba52/downmix.c",
        "liba52/liba52/imdct.c",
        "liba52/liba52/parse.c",
    ],
    local_include_dirs: [
        "liba52/include",
        "liba52/liba52",
    ],
    export_include_dirs: ["liba52/include"],
    cflags: [
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-field-initializers",
        "-Wno-constant-conversion",
        "-Wno-shift-negative-value",
        "-Wno-self-assign",
    ],
}

// Vendored rcheevos (RetroAchievements official C library, v12.3.0, MIT - see
// rcheevos/LICENSE). Provides rc_client (the recommended high-level achievement
// client that owns the runtime, server protocol, hardcore policy, session/ping
// and unlock queueing), the rc_api server request builders + JSON parsers, and
// the canonical ROM hashers (rc_hash). drastic-nano links this to evaluate DS
// achievements against the emulator's Main RAM and talk to retroachievements.org.
//
// File set follows the upstream Package.swift: everything under src, src/rcheevos,
// src/rapi and src/rhash, minus rc_libretro.c, rc_client_external.c and the
// Windows-only rc_client_raintegration.c (already pruned from the vendored tree).
// RC_DISABLE_LUA drops the Lua dependency (DS achievement logic never uses Lua);
// RC_CLIENT_SUPPORTS_HASH enables rc_client_begin_identify_and_load_game's hashing.
// Built -Wno-error because upstream C is not clean under Soong's warning set (same
// treatment as liba52_nano above).
cc_library_static {
    name: "librcheevos_nano",
    srcs: [
        "rcheevos/src/*.c",
        "rcheevos/src/rcheevos/*.c",
        "rcheevos/src/rapi/*.c",
        "rcheevos/src/rhash/*.c",
    ],
    local_include_dirs: [
        "rcheevos/include",
        "rcheevos/src",
        "rcheevos/src/rcheevos",
    ],
    export_include_dirs: ["rcheevos/include"],
    shared_libs: ["libz"],
    cflags: [
        "-DRC_DISABLE_LUA",
        "-DRC_CLIENT_SUPPORTS_HASH",
        "-std=gnu11",
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-field-initializers",
        "-Wno-constant-conversion",
        "-Wno-shift-negative-value",
        "-Wno-self-assign",
        "-Wno-pointer-sign",
    ],
}

sh_binary {
    name: "nano-ce-unlock.sh",
    src: "nano-ce-unlock.sh",
}

sh_binary {
    name: "joypad_uevent_fixup.sh",
    src: "joypad_uevent_fixup.sh",
}

// GammaOS Nano XMB assets. Ported from the PS3 XMB recreation: the captured
// cloth-wave geometry, per-month gradient textures, normal-map / glass icon
// material, Rodin fonts and the cold-boot logo plates. Installed read-only to
// /system/etc/nano_xmb/<sub_dir>/; the renderer also checks
// /data/system/nano_xmb/ first so assets can be pushed during development
// without rebuilding the system image.
prebuilt_etc {
    name: "nano_xmb_fonts",
    srcs: ["ps3xmb/fonts/*.ttf"],
    sub_dir: "nano_xmb/fonts",
}

prebuilt_etc {
    name: "nano_xmb_wave",
    srcs: ["ps3xmb/wave/*.bin"],
    sub_dir: "nano_xmb/wave",
}

prebuilt_etc {
    name: "nano_xmb_gradients",
    srcs: ["ps3xmb/gradients/*.png"],
    sub_dir: "nano_xmb/gradients",
}

prebuilt_etc {
    name: "nano_xmb_boot",
    srcs: ["ps3xmb/boot/*.png"],
    sub_dir: "nano_xmb/boot",
}

prebuilt_etc {
    name: "nano_xmb_icons",
    srcs: ["ps3xmb/icons/*.png"],
    sub_dir: "nano_xmb/icons",
}

prebuilt_etc {
    name: "nano_xmb_normalmaps",
    srcs: ["ps3xmb/normalmaps/*.png"],
    sub_dir: "nano_xmb/normalmaps",
}

prebuilt_etc {
    name: "nano_xmb_glass",
    srcs: ["ps3xmb/assets/*.png"],
    sub_dir: "nano_xmb/assets",
}

prebuilt_etc {
    name: "nano_xmb_textures",
    srcs: ["ps3xmb/textures/*.png"],
    sub_dir: "nano_xmb/textures",
}

// GammaEQ audio preview clip: a short 48kHz/16-bit/stereo PCM WAV looped by the
// nano (AAudio) so the equalizer is audible while you adjust it. Loaded from
// /data/system/nano_xmb/audio/ first (dev override), else this install path.
prebuilt_etc {
    name: "nano_xmb_audio",
    srcs: ["ps3xmb/audio/*.wav"],
    sub_dir: "nano_xmb/audio",
}

// Music player control-panel + status + codec-badge icons (the web app's
// images/audioplayer set). Loaded lazily on first Now-Playing entry. Dev override
// /data/system/nano_xmb/audioplayer/ is checked first.
prebuilt_etc {
    name: "nano_xmb_audioplayer",
    srcs: ["ps3xmb/audioplayer/*.png"],
    sub_dir: "nano_xmb/audioplayer",
}

// Video player control-panel icons (scene / go-to / audio / subtitle / transport
// etc), decoded full-colour. Loaded lazily on first video-player entry. Dev
// override /data/system/nano_xmb/videoplayer/ is checked first.
prebuilt_etc {
    name: "nano_xmb_videoplayer",
    srcs: ["ps3xmb/videoplayer/*.png"],
    sub_dir: "nano_xmb/videoplayer",
}

// Canyon music visualizer assets: the 128x128 tangent-space normal/height map the
// terrain flythrough displaces from (CPU-precomputed height). Dev override
// /data/system/nano_xmb/canyon/ is checked first.
prebuilt_etc {
    name: "nano_xmb_canyon",
    srcs: ["ps3xmb/canyon/*.png"],
    sub_dir: "nano_xmb/canyon",
}

// Photo viewer control-panel icons (rotate / zoom / slideshow / display etc),
// decoded full-colour. Dev override /data/system/nano_xmb/photoviewer/ first.
prebuilt_etc {
    name: "nano_xmb_photoviewer",
    srcs: ["ps3xmb/photoviewer/*.png"],
    sub_dir: "nano_xmb/photoviewer",
}

prebuilt_etc {
    name: "nano_xmb_backgrounds",
    srcs: ["ps3xmb/backgrounds/*.jpg"],
    sub_dir: "nano_xmb/backgrounds",
}

// 3D Earth maps for the Time Zone globe selector (web tzglobe screen). Day /
// night / clouds equirectangular maps, resized to 1024x512 power-of-two PNG so
// GLES2 can use GL_REPEAT longitude wrap + mipmaps (the source JPGs cannot ship:
// the nano decoder is libpng-only).
prebuilt_etc {
    name: "nano_xmb_globe",
    srcs: ["ps3xmb/globe/*.png"],
    sub_dir: "nano_xmb/globe",
}

// Per-language UI translation resources (English-keyed JSON objects). Loaded at
// runtime by NanoI18n (trDyn) from /system/etc/gammaos-nano/i18n/<code>.json
// when the user picks a non-English locale. "en" is passthrough, so no en.json.
// Editable/over-ridable via /data/system/nano_i18n/<code>.json without a rebuild.
prebuilt_etc {
    name: "nano_xmb_i18n",
    srcs: [
        "ps3xmb/i18n/es.json",
        "ps3xmb/i18n/fr.json",
        "ps3xmb/i18n/de.json",
        "ps3xmb/i18n/it.json",
        "ps3xmb/i18n/pt.json",
        "ps3xmb/i18n/nl.json",
        "ps3xmb/i18n/ru.json",
        "ps3xmb/i18n/ja.json",
        "ps3xmb/i18n/ko.json",
        "ps3xmb/i18n/zh-cn.json",
        "ps3xmb/i18n/zh-tw.json",
        "ps3xmb/i18n/ar.json",
        "ps3xmb/i18n/tr.json",
        "ps3xmb/i18n/pl.json",
    ],
    sub_dir: "gammaos-nano/i18n",
}

// The full RetroArch monochrome XMB icon set (849 white-on-transparent system
// silhouettes, LibretroDB names). Asset-only: never textured en masse; read on
// demand by the icon grid picker (thumbnails) and per-system icon resolution
// (one full icon per assigned system, glass-relit via bevelFromRGBA). The dev
// override /data/system/nano_xmb/icons_retroarch/ is checked first.
prebuilt_etc {
    name: "nano_xmb_icons_retroarch",
    srcs: ["ps3xmb/icons_retroarch/*.png"],
    sub_dir: "nano_xmb/icons_retroarch",
}

// Framework/SystemUI vector icons rasterised to mono-white silhouettes for the
// generic UI menu rows (Screen Orientation, Notifications, Security, Brightness,
// System Settings, Memory Card, Accessories ...). Glass-relit at runtime via
// bevelFromRGBA, the same path as the console icons, so they share the look.
// nmapForIcon maps the UI icon index range to these by name.
prebuilt_etc {
    name: "nano_xmb_icons_ui",
    srcs: ["ps3xmb/icons_ui/*.png"],
    sub_dir: "nano_xmb/icons_ui",
}

// DSi System Menu theme (persist.gammaos.nano.ndstheme) 4x assets: the DSVec vector
// fonts (dsvec.ttf letters / dsvecnum.ttf digits) and the SVG-rasterised sprites
// (cell_00 selection frame, tile_white). Installed to /system/etc/nano_xmb/nds so the
// theme works after a factory reset (the runtime dev-override under /data is checked
// first, this is the bundled fallback).
prebuilt_etc {
    name: "nano_xmb_nds",
    srcs: ["ps3xmb/nds/*"],
    sub_dir: "nano_xmb/nds",
}

// Daijishou community platform configs (119 platforms, ~917 players covering
// RetroArch cores AND standalone emulators - AetherSX2, Dolphin, azahar, etc.).
// Parsed at runtime by the Game Systems editor's Emulator chooser to auto-fill
// launch type / package / intent / extensions. The dev override
// /data/system/nano_xmb/daijishou/ is checked first.
prebuilt_etc {
    name: "nano_xmb_daijishou",
    srcs: ["ps3xmb/daijishou/*.json"],
    sub_dir: "nano_xmb/daijishou",
}

// Source files shared with the drastic-nano binary. drastic-nano
// reuses the DRM rendering stack, DrasticRunner lifecycle, and
// FakeJNI shim from gammaos-nano; wrapping them in a filegroup lets
// Soong compile them into drastic-nano without moving the files out
// of their canonical location here.
filegroup {
    name: "drastic_nano_shared_srcs",
    srcs: [
        "NanoMenuDrm.cpp",
        "DrasticRunner.cpp",
        "FakeJNI.cpp",
        "NanoJson.cpp",
        "NanoI18n.cpp",
    ],
}
