package {
    default_applicable_licenses: ["frameworks_base_license"],
}

cc_binary {
    name: "gammaos-nano",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
        "-Wno-deprecated-declarations",
        // GammaOS: aggressive optimization for Nano render hot path.
        // NanoMenu has no IEEE float correctness requirements and the blit
        // loops benefit from vectorization/unrolling.
        "-O3",
        "-ffast-math",
        "-fno-math-errno",
        "-fno-trapping-math",
    ],

    arch: {
        arm64: {
            cflags: [
                // Tune pipeline scheduling for Cortex-A55 (RG DS / RK3568 and
                // most handheld targets). This does NOT change the target
                // architecture baseline (still ARMv8-A); it only hints at
                // A55's in-order 2-wide issue to help instruction scheduling.
                // The binary remains compatible with any ARMv8-A device.
                "-mtune=cortex-a55",
            ],
        },
    },

    srcs: [
        "main.cpp",
        "NanoMenu.cpp",
        "NanoMenuDrm.cpp",
        "NanoMenuXmb.cpp",
        "NanoMenuShaders.cpp",
        "NanoMenuEffects.cpp",
        "NanoMenuInput.cpp",
        "NanoMenuState.cpp",
        "NanoMenuSystem.cpp",
        "NanoMenuNet.cpp",
        "NanoMenuSettings.cpp",
        "NanoMenuSettingsTree.cpp",
        "NanoMenuSettingsRender.cpp",
        "NanoMenuRender.cpp",
        "LibretroRunner.cpp",
        "FakeJNI.cpp",
        "DrasticRunner.cpp",
    ],

    header_libs: [
        "libdrm_headers",
        "jni_headers",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv2",
        "libft2",
        "libpng",
        "libz",
        "android.hardware.health-V2-ndk",
        "android.hardware.light-V2-ndk",
        "android.hardware.light@2.0",
        "libhidlbase",
        "libnativewindow",
    ],

    init_rc: ["gammaos-nano.rc"],
    required: [
        "nano-ce-unlock.sh",
        "joypad_uevent_fixup.sh",
    ],
}

sh_binary {
    name: "nano-ce-unlock.sh",
    src: "nano-ce-unlock.sh",
}

sh_binary {
    name: "joypad_uevent_fixup.sh",
    src: "joypad_uevent_fixup.sh",
}

// Source files shared with the drastic-nano binary. drastic-nano
// reuses the DRM rendering stack, DrasticRunner lifecycle, and
// FakeJNI shim from gammaos-nano; wrapping them in a filegroup lets
// Soong compile them into drastic-nano without moving the files out
// of their canonical location here.
filegroup {
    name: "drastic_nano_shared_srcs",
    srcs: [
        "NanoMenuDrm.cpp",
        "DrasticRunner.cpp",
        "FakeJNI.cpp",
    ],
}
