# gammaos-nano runs as root so it can talk to WifiService /
# BluetoothManagerService via `cmd wifi` / `cmd bluetooth_manager`
# directly (both services enforce Binder.getCallingUid() == ROOT_UID
# || SHELL_UID). The group list keeps the graphics / input / media
# access nano already needed for DRM, evdev grab and playlist reads.
#
# DAC_OVERRIDE + DAC_READ_SEARCH let us traverse the existing XMB
# ROM-list cache dir at /data/system/nano_xmb_cache/ (0700
# graphics:graphics from when nano used to run as uid graphics), and
# CHOWN/FOWNER let us migrate the dir + files to root:root 0755/0644
# on first boot after the switch so subsequent sessions work without
# relying on the override caps.
#
# SYS_ADMIN + SYS_CHROOT are needed because nano starts early (class
# core animation) and runs in init's bootstrap mount namespace, which
# only has the bootstrap apex set. The gammaos-net helper script uses
# `nsenter -t 1 -m` to re-enter init's (default) mount namespace
# before exec'ing app_process so
# /apex/com.android.art/lib64/libnativeloader.so is visible. The
# kernel's mntns_install() requires CAP_SYS_ADMIN in the target user
# namespace AND both CAP_SYS_ADMIN and CAP_SYS_CHROOT in the current
# user namespace -- missing SYS_CHROOT returns EPERM on setns(2)
# even though the /proc/1/ns/mnt open() already succeeded.
#
# SYS_PTRACE is needed to open /proc/1/ns/mnt. The kernel gates
# access to other processes' ns/ files through ptrace_may_access
# (PTRACE_MODE_READ_FSCREDS), which compares the caller's real uid,
# euid, suid AND full supplementary group set against the target's.
# Nano runs uid=0 but carries a large supplementary group list
# (graphics, system, readproc, ...), while init has no supplementary
# groups at all, so the group-set match fails and the check falls
# back to requiring CAP_SYS_PTRACE in the target's user namespace.
# Without it, open(/proc/1/ns/mnt) returns EACCES and nsenter aborts.
#
# readproc is in the group list because Android's /proc is mounted
# with hidepid=invisible,gid=3009: a root-uid caller without the
# readproc supplementary group can't even see /proc/1, which makes
# `nsenter -t 1 -m` fail with ENOENT inside gammaos-net.sh. Adding
# readproc restores traversal of other processes' /proc entries.
service gammaos-nano /system/bin/gammaos-nano
    class core animation
    user root
    group root graphics input system media_rw sdcard_rw everybody external_storage package_info readproc inet
    # BLOCK_SUSPEND lets nano hold a kernel wakelock (/sys/power/wake_lock) so
    # music keeps playing with the screen off after USB is unplugged. Without it
    # the write returns EPERM and the SoC suspends on unplug, killing the audio.
    capabilities SYS_NICE IPC_LOCK SYS_RESOURCE DAC_OVERRIDE DAC_READ_SEARCH CHOWN FOWNER SYS_ADMIN SYS_PTRACE SYS_CHROOT BLOCK_SUSPEND
    disabled
    oneshot
    ioprio rt 0
    rlimit rtprio 99 99
    rlimit memlock 536870912 536870912
    task_profiles MaxPerformance

# Re-apply Bluetooth rfkill ownership after minimal_boot is set. Vendor
# init's `on zygote-start` chowns /sys/class/rfkill/rfkill0/state to
# bluetooth:system, but on this hardware the rfkill sysfs nodes aren't
# populated yet when zygote-start fires, so the chown silently no-ops
# and the BT HAL can't flip the power rail (bt_upio logs "Permission
# denied" on open). By the time minimal_boot=1 is set (after SF is
# running) the rfkill0 node definitely exists, and a retry here lets
# the HAL turn the radio on.
# GammaOS Nano: the in-game XMB overlay (power-hold). A SEPARATE, resident
# instance of gammaos-nano launched with --overlay. It runs in the full-Android
# context (SurfaceFlinger + WindowManager up) as a translucent, background-
# blurred layer over the running app, created hidden and toggled by
# sys.gammaos.nano.show_overlay (set by PhoneWindowManager on a power-hold).
# Opt-in via persist.gammaos.nano.overlay=1, and only meaningful once the system
# is fully up (SF must exist before readyToRun creates the layer), so it is
# gated on sys.boot_completed. It is NOT oneshot: it stays alive, hidden, ready
# to be summoned instantly. Same caps/groups/domain as the home service.
service gammaos-nano-overlay /system/bin/gammaos-nano --overlay
    class core animation
    user root
    group root graphics input system media_rw sdcard_rw everybody external_storage package_info readproc inet
    capabilities SYS_NICE IPC_LOCK SYS_RESOURCE DAC_OVERRIDE DAC_READ_SEARCH CHOWN FOWNER SYS_ADMIN SYS_PTRACE SYS_CHROOT KILL BLOCK_SUSPEND
    disabled
    ioprio rt 0
    rlimit rtprio 99 99
    rlimit memlock 536870912 536870912
    task_profiles MaxPerformance

# The in-game overlay feature is gated on nano mode (sys.gammaos.minimal_boot=1).
# persist.gammaos.nano.overlay is a persist prop that stays 1 even after the user boots
# NORMAL Android, so gating the overlay on it alone would enable it there too - and the
# overlay would relaunch the boot animation (readyToRun's skip_nano bail) and eat the
# stock power menu. minimal_boot is the precise "nano home is running" signal. The binary
# also self-guards on persist.bootanim.skip_nano as a backstop. (The overlay START used
# to be a boot_completed trigger here, which left the DRM home and the overlay running at
# the same time; it now starts on the app-launch handoff below - DRM-home XOR overlay.)
# Default the in-game overlay ON. When nano mode engages, fill in the opt-in if
# the user has never set it. Persisted props load from /data before minimal_boot is
# set, so an explicit persist.gammaos.nano.overlay=0 (or 1) is already present and
# the empty match below fails - this only defaults the unset case and never
# overrides the user's choice.
on property:sys.gammaos.minimal_boot=1 && property:persist.gammaos.nano.overlay=
    setprop persist.gammaos.nano.overlay 1

# Default overlay-home ON the same way (fill in only when the user has never set it).
# overlay_home makes the resident overlay the persistent post-app launcher: on app exit
# nanoRaiseOverlay() raises the already-alive overlay as the full-wallpaper XMB instead
# of restarting the home nano (which fights SF and flashes black through a mode switch).
# It is a persist prop with no build/runtime writer, so after a /data wipe it was unset
# and nanoRaiseOverlay() returned false: app exit relaunched a fresh home (broke the
# seamless return and made post-app sleep slow). An explicit persist value (0 or 1)
# already in /data makes the empty match fail, so this never overrides the user's choice.
on property:sys.gammaos.minimal_boot=1 && property:persist.gammaos.nano.overlay_home=
    setprop persist.gammaos.nano.overlay_home 1

# GammaOS Nano: DRM-home XOR overlay - the DRM home and the SF overlay must NEVER run
# at the same time. The overlay is therefore NOT started at boot_completed (that left
# BOTH alive at the cold-boot home, wasting ~100MB incl ~65MB of GPU buffers for a
# parked process). It starts on the FIRST app launch, AFTER the DRM home has fully
# exited: app_launched=1 is set (RootWindowContainer) while the home is still draining
# its drmStop()+exit, and the home (oneshot) only flips init.svc.gammaos-nano=stopped
# once it has returned and released DRM master. ANDing both guarantees the home is gone
# before the overlay starts - no overlap, no DRM-master contention. A bare app_launched
# trigger would fire mid-drmStop and reintroduce the overlap. minimal_boot keeps it
# nano-only. Once started, the overlay is the home for the rest of the session
# (overlay_home); the DRM home does not return until reboot.
on property:sys.gammaos.nano.app_launched=1 && property:init.svc.gammaos-nano=stopped && property:persist.gammaos.nano.overlay=1 && property:sys.gammaos.minimal_boot=1
    start gammaos-nano-overlay

# GammaOS Nano: hand off to the gammaos-ota flasher for a themed System Update. nano browses +
# confirms the package itself (owning the DRM panel). On Install, nano sets
# sys.gammaos.ota.theme/package/autoinstall and then sys.gammaos.ota.prestage=1, and STAYS UP on
# a themed "Preparing update... X%" screen. This rule starts gammaos-ota WHILE nano is still alive
# so the flasher can pre-stage itself to tmpfs in the background (the slow ~60s copy) with the panel
# never going black. The flasher does not touch the display while staging; when it is staged it
# sets sys.gammaos.ota.staged=1 and waits. nano then drops DRM master cleanly via drmStop()
# (mirroring the proven app-launch handoff) and exits, so the still-running SurfaceFlinger
# re-acquires the CRTC and the flasher's OtaMenu OFF->ON power transition presents the flash UI with
# no black gap. We do NOT restart surfaceflinger (that cascaded a zygote/system_server restart via
# surfaceflinger.rc onrestart, relaunching the nano home over the flasher). prestage is a volatile
# prop, so it never persists a reboot. gammaos-ota is disabled + oneshot.
on property:sys.gammaos.ota.prestage=1
    start gammaos-ota

# GammaOS Nano: respawn a crashed overlay-home. After the first app launch the overlay
# is the SOLE home; if it dies (watchdog SIGABRT / SF death) the user would be left with
# no UI. Gate on sys.gammaos.nano.overlay_ran, which the overlay sets ONLY after it has
# initialised its SF layer once (NanoMenuOverlay.cpp), so this can never fire at the
# cold-boot home (overlay has never run there) and hot-loop against the DRM home. Bring
# it back as the full-wallpaper home.
on property:init.svc.gammaos-nano-overlay=stopped && property:sys.gammaos.nano.overlay_ran=1 && property:persist.gammaos.nano.overlay=1
    setprop sys.gammaos.nano.app_launched 0
    setprop sys.gammaos.nano.overlay_wallpaper 1
    setprop sys.gammaos.nano.show_overlay 1
    start gammaos-nano-overlay

# GammaOS Nano: disable Bluetooth profiles unused on a retro handheld - NANO MODE ONLY.
# Gated on minimal_boot, so NORMAL Android keeps every profile (these are persist-less,
# non-ro props read at BT-stack init; nano enables BT only after boot_completed via
# init.nano_hal_optimize.rc, well after minimal_boot=1, so the overrides are in place
# first). Trims profile-service objects + worker threads from com.android.bluetooth, and
# pbap.server=false also stops acore (ContactsProvider) being force-started to serve a
# phonebook nano never has. KEPT: gatt, a2dp.source, avrcp.target (headphone buttons),
# hid.host (BT controllers/keyboards), hfp.ag (headset mic), bas.client (device battery).
on property:sys.gammaos.minimal_boot=1
    setprop bluetooth.profile.pbap.server.enabled false
    setprop bluetooth.profile.map.server.enabled false
    setprop bluetooth.profile.sap.server.enabled false
    setprop bluetooth.profile.opp.enabled false
    setprop bluetooth.profile.pan.nap.enabled false
    setprop bluetooth.profile.pan.panu.enabled false
    setprop bluetooth.profile.hid.device.enabled false
    setprop bluetooth.profile.asha.central.enabled false

on property:sys.gammaos.minimal_boot=1
    chown bluetooth system /sys/class/rfkill/rfkill0/state
    chmod 0664 /sys/class/rfkill/rfkill0/state
    start nano-ce-unlock
    start nano-pmdown

service nano-ce-unlock /system/bin/nano-ce-unlock.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:su:s0

# GammaOS Nano: raise the codec DAPM speaker power-down delay (pmdown_time) early, before
# the boot chime's amp would power down (default ~5000 ms). On a first boot the setup wizard
# idles far longer than that after the chime, so the external speaker amp powers off and the
# vendor audio HAL never re-powers it -> the whole system is silent after setup (a reboot
# "fixes" it). Keeping the amp warm through the setup idle fixes it without holding card0.
# init-side (not nano-side) so it runs regardless of nano's render mode; device-agnostic glob
# over every codec dailink pmdown_time that exists, retried for a few seconds until the codec
# platform device is probed. Affects every device with this DAPM pattern.
service nano-pmdown /system/bin/nano-pmdown.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0

# GammaOS Nano: re-emit input subsystem uevents after apexd has finished
# its activation flood. On the Brick (and similar devices since the
# boot-speed work in 2026-05-13), trimui_inputd creates the TRIMUI
# Player1 uinput device on late-fs at T+~8 s, and apexd-bootstrap +
# main apexd activation pump dozens of loop / dm-verity uevents through
# ueventd at T+5 to T+11 s. The TRIMUI Player1 add uevent gets dropped
# in that flood, so /dev/input/event3 is never created, NanoMenu cannot
# read joypad input, and the BTN_A -> RetroArch handoff chain stalls
# (user-visible symptom: home app shows up with unresponsive controls).
# Re-emitting "add" to each input event's sysfs uevent file forces the
# kernel to send a fresh netlink message that ueventd handles cleanly
# now that the flood is over. Writing to a non-existent path is a
# no-op (init logs and continues), so listing event0 through event9
# covers the typical input device set on our supported hardware.
on property:apexd.status=activated
    write /sys/class/input/event0/uevent add
    write /sys/class/input/event1/uevent add
    write /sys/class/input/event2/uevent add
    write /sys/class/input/event3/uevent add
    write /sys/class/input/event4/uevent add
    write /sys/class/input/event5/uevent add
    write /sys/class/input/event6/uevent add
    write /sys/class/input/event7/uevent add
    write /sys/class/input/event8/uevent add
    write /sys/class/input/event9/uevent add

# Belt-and-suspenders: apexd transitions starting -> activated -> ready
# very quickly in our boot sequence (vold lock fix removed the ~12 s
# stall during Initialize), so init's property-change watcher may
# observe only the "ready" transition. Trigger the same re-emit on
# both states so we are guaranteed to fire at least once.
on property:apexd.status=ready
    write /sys/class/input/event0/uevent add
    write /sys/class/input/event1/uevent add
    write /sys/class/input/event2/uevent add
    write /sys/class/input/event3/uevent add
    write /sys/class/input/event4/uevent add
    write /sys/class/input/event5/uevent add
    write /sys/class/input/event6/uevent add
    write /sys/class/input/event7/uevent add
    write /sys/class/input/event8/uevent add
    write /sys/class/input/event9/uevent add

# Final fallback: when NanoMenu's gammaos-nano service is running we
# definitely want /dev/input/event3 to exist so NanoMenu can grab it.
# This fires shortly after T+7 s of boot, which is before trimui_inputd
# typically registers its uinput device at T+~8 s. The service-based
# retry loop below handles the race more robustly than a single write.
service joypad_uevent_fixup /system/bin/joypad_uevent_fixup.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:init.svc.gammaos-nano=running
    start joypad_uevent_fixup

on property:apexd.status=ready
    start joypad_uevent_fixup

on property:sys.boot_completed=1
    start joypad_uevent_fixup

# GammaOS Nano: universal FIXED_PERFORMANCE power-mode hint while the overlay UI
# is up, released when an app takes the foreground. nano flips
# sys.gammaos.nano.fixedperf (gated by persist.gammaos.nano.perf.fixedperf) and
# `cmd power` applies it through PowerManagerService -> the IPower HAL. Run as
# root in the permissive su domain so the binder shell-command + DEVICE_POWER
# checks pass. This keeps the frequency policy in the platform, not in nano.
service nano-fixedperf-on /system/bin/cmd power set-fixed-performance-mode-enabled true
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service nano-fixedperf-off /system/bin/cmd power set-fixed-performance-mode-enabled false
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.gammaos.nano.fixedperf=1
    start nano-fixedperf-on

on property:sys.gammaos.nano.fixedperf=0
    start nano-fixedperf-off

# GammaOS Nano: real system sleep for the DRM-home XMB. The home nano owns the power
# evdev node and blanks its own direct-DRM panel, but it runs in init's bootstrap
# mount namespace and cannot exec app_process, so it asks init (which is in the
# default namespace) to inject KEYCODE_SLEEP / KEYCODE_WAKEUP. That drives
# PowerManager's normal goToSleep -> doze -> suspend and wakeUp, giving a true
# low-power sleep instead of a blanked busy-poll. dosleep/dowake are set ONLY by the
# home nano (NanoMenuInput.cpp) and by drastic-nano's in-game power handler
# (drastic-nano/main.cpp doSleep), so these never fire in normal Android. Each
# trigger resets its prop so the next sleep/wake is a fresh edge.
service nano-dosleep /system/bin/sh -c "/system/bin/input keyevent 223"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service nano-dowake /system/bin/sh -c "/system/bin/input keyevent 224"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.gammaos.nano.dosleep=1
    start nano-dosleep
    setprop sys.gammaos.nano.dosleep 0

on property:sys.gammaos.nano.dowake=1
    start nano-dowake
    setprop sys.gammaos.nano.dowake 0
