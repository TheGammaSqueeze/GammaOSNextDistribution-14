package {
    default_applicable_licenses: ["frameworks_base_license"],
}

cc_binary {
    name: "gammaos-ota",

    cflags: [
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
        "-Wno-deprecated-declarations",
        "-D_FILE_OFFSET_BITS=64",
    ],

    srcs: [
        "main.cpp",
        "OtaMenu.cpp",
        "OtaFlasher.cpp",
        "OtaManifest.cpp",
        "XzDecompressor.cpp",
        "OtaDisplay.cpp",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "liblog",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv2",
        "libft2",
        "liblp",
        "libfs_mgr",
        "libsparse",
        "libz",
        "libcrypto",
        "android.hardware.boot@1.1",
        "libhidlbase",
    ],

    static_libs: [
        "libdm",
    ],

    init_rc: ["gammaos-ota.rc"],
}
