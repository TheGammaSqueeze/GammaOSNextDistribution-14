cc_binary {
    name: "gammapad",
    srcs: [
        "main.cpp",
        "GamepadManager.cpp",
        "VirtualGamepad.cpp",
        "VirtualMouse.cpp",
        "VirtualTouchscreen.cpp",
        "InputTransformer.cpp",
        "ForceFeedback.cpp",
        "KeyLayoutParser.cpp",
        "MouseMode.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
    ],
    init_rc: ["gammapad.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}

cc_binary {
    name: "gammapad_restore",
    srcs: ["restore.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
